prefix=${pcfiledir}/@MYLITE_PKGCONFIG_PREFIX_RELATIVE@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: MyLite
Description: @PROJECT_DESCRIPTION@
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmylite
Libs.private: @MYLITE_PKGCONFIG_PRIVATE_LIBS@
Cflags: -I${includedir}
