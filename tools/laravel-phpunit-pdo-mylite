#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image="${MYLITE_LARAVEL_DOCKER_IMAGE:-mylite-laravel-phpunit:php84}"
laravel_repo="${MYLITE_LARAVEL_REPO:-https://github.com/laravel/laravel.git}"
laravel_ref="${MYLITE_LARAVEL_REF:-945f4e5a9fd3695dc0ee512f497c650fb82cfbb8}"
laravel_framework_version="${MYLITE_LARAVEL_FRAMEWORK_VERSION:-12.62.0}"
laravel_dir="${MYLITE_LARAVEL_DIR:-${root_dir}/build/laravel-application}"
suite_dir="${MYLITE_LARAVEL_SUITE_DIR:-${root_dir}/build/laravel-mylite-tests}"
cmake_build_dir="${MYLITE_LARAVEL_CMAKE_BUILD_DIR:-${root_dir}/build/laravel-php-mylite}"
cmake_build_type="${MYLITE_LARAVEL_CMAKE_BUILD_TYPE:-Release}"
db_path="${MYLITE_LARAVEL_DB_PATH:-${root_dir}/build/laravel-tests.mylite}"
package_dir="${root_dir}/packages/php-laravel-mylite"
container_root="/work"
container_laravel_dir="${container_root}${laravel_dir#"${root_dir}"}"
container_suite_dir="${container_root}${suite_dir#"${root_dir}"}"
container_cmake_build_dir="${container_root}${cmake_build_dir#"${root_dir}"}"
container_db_path="${container_root}${db_path#"${root_dir}"}"
container_package_dir="${container_root}${package_dir#"${root_dir}"}"

build_image() {
  docker build -t "${image}" - <<'DOCKERFILE'
FROM composer:2@sha256:5946476338742b200bb9ff88f8be56275ddae4b3949c72305cb0dbf10cfcb760 AS composer
FROM php:8.4-cli-bookworm@sha256:138a210978c7767ef2a26f499c413fe6de1c13233c9a5068139565c81191b1ac

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libgmp-dev \
    libonig-dev \
    libzip-dev \
    ninja-build \
    pkg-config \
    unzip \
    zlib1g-dev \
  && docker-php-ext-install -j"$(nproc)" ftp gmp mbstring zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
DOCKERFILE
}

usage() {
  cat <<USAGE
usage: tools/laravel-phpunit-pdo-mylite [command] [phpunit-args...]

Commands:
  image                 Build the Docker image.
  fetch-laravel         Fetch the fresh Laravel application checkout.
  build-extensions      Build the MyLite PHP extensions and PHP wrapper.
  install-dependencies  Install Laravel, the MyLite driver package, and PHPUnit.
  build                 Build the Docker image and full PHPUnit environment.
  test                  Run migrations and the Laravel application PHPUnit suite.
  run                   Build the environment, then run the Laravel application PHPUnit suite.
USAGE
}

run_container() {
  docker run --rm -i \
    --user "$(id -u):$(id -g)" \
    -e COMPOSER_HOME=/tmp/mylite-composer-home \
    -e MYLITE_LARAVEL_REPO="${laravel_repo}" \
    -e MYLITE_LARAVEL_REF="${laravel_ref}" \
    -e MYLITE_LARAVEL_FRAMEWORK_VERSION="${laravel_framework_version}" \
    -e MYLITE_LARAVEL_DIR="${container_laravel_dir}" \
    -e MYLITE_LARAVEL_SUITE_DIR="${container_suite_dir}" \
    -e MYLITE_LARAVEL_CMAKE_BUILD_DIR="${container_cmake_build_dir}" \
    -e MYLITE_LARAVEL_CMAKE_BUILD_TYPE="${cmake_build_type}" \
    -e MYLITE_LARAVEL_DB_PATH="${container_db_path}" \
    -e MYLITE_LARAVEL_PACKAGE_DIR="${container_package_dir}" \
    -v "${root_dir}:${container_root}" \
    -w "${container_root}" \
    "${image}" \
    bash -s -- "$@" <<'CONTAINER'
set -euo pipefail

container_phase="${1:-run}"
if [ "$#" -gt 0 ]; then
  shift
fi
php_wrapper="${MYLITE_LARAVEL_CMAKE_BUILD_DIR}/mylite-laravel-php"
mylite_extension="${MYLITE_LARAVEL_CMAKE_BUILD_DIR}/packages/php-ext-mylite/mylite.so"
pdo_extension="${MYLITE_LARAVEL_CMAKE_BUILD_DIR}/packages/php-ext-pdo-mylite/pdo_mylite.so"
php_ini_dir="${MYLITE_LARAVEL_CMAKE_BUILD_DIR}/php-conf.d"

phase() {
  printf '\n==> %s\n' "$*"
}

seconds_since() {
  local start="$1"
  local end
  end="$(date +%s)"
  echo "$((end - start))"
}

require_executable() {
  if [ ! -x "$1" ]; then
    printf '%s\n' "missing executable: $1" >&2
    printf '%s\n' "run tools/laravel-phpunit-pdo-mylite build first" >&2
    exit 1
  fi
}

fetch_laravel_application() {
  mkdir -p "${COMPOSER_HOME}" "$(dirname "${MYLITE_LARAVEL_DIR}")"

  phase "Fetch fresh Laravel application"
  local fetch_start
  fetch_start="$(date +%s)"
  if [ ! -d "${MYLITE_LARAVEL_DIR}/.git" ]; then
    git init "${MYLITE_LARAVEL_DIR}"
    git -C "${MYLITE_LARAVEL_DIR}" remote add origin "${MYLITE_LARAVEL_REPO}"
  fi
  git -C "${MYLITE_LARAVEL_DIR}" fetch --depth 1 origin "${MYLITE_LARAVEL_REF}"
  git -C "${MYLITE_LARAVEL_DIR}" checkout --detach FETCH_HEAD
  laravel_sha="$(git -C "${MYLITE_LARAVEL_DIR}" rev-parse HEAD)"
  echo "laravel_application_sha=${laravel_sha}"
  echo "laravel_fetch_seconds=$(seconds_since "${fetch_start}")"
}

build_mylite_php_extensions() {
  phase "Build MyLite PHP extensions"
  local build_start
  build_start="$(date +%s)"
  cmake -S . -B "${MYLITE_LARAVEL_CMAKE_BUILD_DIR}" -G Ninja \
    -DCMAKE_BUILD_TYPE="${MYLITE_LARAVEL_CMAKE_BUILD_TYPE}" \
    -DMYLITE_WARNINGS_AS_ERRORS=ON \
    -DMYLITE_BUILD_PHP_EXTENSIONS=ON \
    -DMYLITE_PHP_CONFIG_EXECUTABLE=/usr/local/bin/php-config \
    -DMYLITE_PHP_EXECUTABLE=/usr/local/bin/php
  cmake --build "${MYLITE_LARAVEL_CMAKE_BUILD_DIR}" --target mylite_php_pdo_extension
  mkdir -p "${php_ini_dir}"
  cat > "${php_ini_dir}/mylite.ini" <<INI
extension=${mylite_extension}
extension=${pdo_extension}
INI
  cat > "${php_wrapper}" <<PHP
#!/usr/bin/env sh
export PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}"
exec /usr/local/bin/php "\$@"
PHP
  chmod +x "${php_wrapper}"
  "${php_wrapper}" -r 'if (!extension_loaded("mylite") || !extension_loaded("pdo_mylite") || !in_array("mylite", PDO::getAvailableDrivers(), true)) { exit(1); }'
  echo "mylite_build_seconds=$(seconds_since "${build_start}")"
}

install_laravel_application_dependencies() {
  mkdir -p "${COMPOSER_HOME}"
  phase "Install Laravel and MyLite driver package"
  local deps_start
  deps_start="$(date +%s)"
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_LARAVEL_DIR}" \
      config repositories.mylite path "${MYLITE_LARAVEL_PACKAGE_DIR}"
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_LARAVEL_DIR}" \
      require "laravel/framework:${MYLITE_LARAVEL_FRAMEWORK_VERSION}" \
      "mylite/laravel-driver:@dev" --no-update --no-interaction
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_LARAVEL_DIR}" \
      install --no-interaction --no-progress --prefer-dist
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_LARAVEL_DIR}" \
      show laravel/framework
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_LARAVEL_DIR}" \
      show mylite/laravel-driver
  echo "laravel_dependency_seconds=$(seconds_since "${deps_start}")"
}

write_laravel_application_suite() {
  mkdir -p "${MYLITE_LARAVEL_SUITE_DIR}"

  cat > "${MYLITE_LARAVEL_DIR}/config/database.php" <<'PHP'
<?php

return [
    'default' => env('DB_CONNECTION', 'mylite'),
    'connections' => [
        'mylite' => [
            'driver' => 'mylite',
            'path' => env('MYLITE_LARAVEL_DB_PATH'),
            'database' => env('MYLITE_LARAVEL_DATABASE', 'laravel_tests'),
            'prefix' => '',
            'options' => [],
        ],
    ],
    'migrations' => [
        'table' => 'migrations',
        'update_date_on_publish' => true,
    ],
];
PHP

  cat > "${MYLITE_LARAVEL_DIR}/database/migrations/2026_07_27_000000_create_mylite_framework_tables.php" <<'PHP'
<?php

use Illuminate\Database\Migrations\Migration;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Schema;

return new class extends Migration
{
    public function up(): void
    {
        Schema::create('framework_users', static function (Blueprint $table): void {
            $table->increments('id');
            $table->string('email', 191)->unique();
            $table->string('name', 191);
            $table->integer('score')->default(0);
        });
        Schema::create('framework_posts', static function (Blueprint $table): void {
            $table->increments('id');
            $table->unsignedInteger('user_id');
            $table->string('title', 191);
            $table->index('user_id');
        });
    }

    public function down(): void
    {
        Schema::dropIfExists('framework_posts');
        Schema::dropIfExists('framework_users');
    }
};
PHP

  cat > "${MYLITE_LARAVEL_SUITE_DIR}/phpunit.xml" <<XML
<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="${MYLITE_LARAVEL_DIR}/vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory="${MYLITE_LARAVEL_SUITE_DIR}/.phpunit.cache">
  <testsuites>
    <testsuite name="Laravel MyLite Application Test Suite">
      <file>${MYLITE_LARAVEL_SUITE_DIR}/LaravelMyLiteApplicationTest.php</file>
    </testsuite>
  </testsuites>
  <php>
    <ini name="date.timezone" value="UTC"/>
    <ini name="memory_limit" value="1024M"/>
    <env name="APP_ENV" value="testing"/>
    <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
    <env name="CACHE_STORE" value="array"/>
    <env name="DB_CONNECTION" value="mylite"/>
    <env name="MYLITE_LARAVEL_DB_PATH" value="${MYLITE_LARAVEL_DB_PATH}"/>
    <env name="MYLITE_LARAVEL_DATABASE" value="laravel_tests"/>
    <env name="MYLITE_LARAVEL_PACKAGE_DIR" value="${MYLITE_LARAVEL_PACKAGE_DIR}"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
  </php>
</phpunit>
XML

  cat > "${MYLITE_LARAVEL_SUITE_DIR}/LaravelMyLiteApplicationTest.php" <<'PHP'
<?php

declare(strict_types=1);

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Database\UniqueConstraintViolationException;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use MyLite\Laravel\MyLiteConnector;
use MyLite\Laravel\MyLiteServiceProvider;
use Tests\TestCase;

final class LaravelMyLiteApplicationTest extends TestCase
{
    public function testConfiguredConnectionMigrationMetadataExceptionsAndTransactions(): void
    {
        $packageDirectory = getenv('MYLITE_LARAVEL_PACKAGE_DIR');
        self::assertIsString($packageDirectory);
        $providerFile = (new ReflectionClass(MyLiteServiceProvider::class))->getFileName();
        self::assertIsString($providerFile);
        self::assertStringStartsWith(realpath($packageDirectory).DIRECTORY_SEPARATOR, $providerFile);

        $connection = DB::connection();
        self::assertSame('mylite', $connection->getDriverName());
        self::assertSame('laravel_tests', $connection->getDatabaseName());
        self::assertTrue(Schema::hasTable('migrations'));
        self::assertTrue(Schema::hasTable('framework_users'));
        self::assertTrue(Schema::hasTable('framework_posts'));

        $columns = Schema::getColumns('framework_users');
        self::assertContains('email', array_column($columns, 'name'));
        $indexes = Schema::getIndexes('framework_users');
        self::assertContains('framework_users_email_unique', array_column($indexes, 'name'));

        $firstId = DB::table('framework_users')->insertGetId([
            'email' => 'first@example.test',
            'name' => 'First',
            'score' => 10,
        ]);
        self::assertSame(1, $firstId);
        DB::table('framework_users')->insert([
            ['email' => 'second@example.test', 'name' => 'Second', 'score' => 20],
            ['email' => 'third@example.test', 'name' => 'Third', 'score' => 5],
        ]);

        $rows = DB::table('framework_users')
            ->where('score', '>=', 10)
            ->orderByDesc('score')
            ->get(['email', 'score']);
        self::assertSame(['second@example.test', 'first@example.test'], $rows->pluck('email')->all());
        self::assertSame([20, 10], $rows->pluck('score')->all());

        try {
            DB::table('framework_users')->insert([
                'email' => 'first@example.test',
                'name' => 'Duplicate',
                'score' => 0,
            ]);
            self::fail('Expected a duplicate-key exception.');
        } catch (UniqueConstraintViolationException $exception) {
            self::assertSame('23000', $exception->errorInfo[0] ?? null);
        }

        try {
            DB::transaction(static function (): void {
                DB::table('framework_users')->insert([
                    'email' => 'rolled-back@example.test',
                    'name' => 'Rollback',
                    'score' => 99,
                ]);
                throw new RuntimeException('rollback');
            });
            self::fail('Expected transaction callback to throw.');
        } catch (RuntimeException $exception) {
            self::assertSame('rollback', $exception->getMessage());
        }
        self::assertSame(
            0,
            DB::table('framework_users')->where('email', 'rolled-back@example.test')->count()
        );
    }

    public function testEloquentPersistenceHydrationAndRelations(): void
    {
        $user = LaravelMyLiteUser::query()->create([
            'email' => 'eloquent@example.test',
            'name' => 'Eloquent',
            'score' => 42,
        ]);
        $user->posts()->create(['title' => 'First post']);

        $loaded = LaravelMyLiteUser::query()
            ->with('posts')
            ->where('email', 'eloquent@example.test')
            ->firstOrFail();

        self::assertIsInt($loaded->id);
        self::assertIsInt($loaded->score);
        self::assertSame(42, $loaded->score);
        self::assertCount(1, $loaded->posts);
        self::assertSame('First post', $loaded->posts[0]->title);
    }

    public function testDriverRejectsInvalidConfiguration(): void
    {
        $cases = [
            [['path' => ''], 'nonempty string'],
            [['path' => "invalid\0path"], 'NUL bytes'],
            [['path' => ':memory:', 'database' => []], 'database must be a string'],
            [['path' => ':memory:', 'options' => 'invalid'], 'options must be an array'],
        ];

        foreach ($cases as [$config, $message]) {
            try {
                (new MyLiteConnector())->connect($config);
                self::fail('Expected invalid MyLite configuration to fail.');
            } catch (InvalidArgumentException $exception) {
                self::assertStringContainsString($message, $exception->getMessage());
            }
        }
    }
}

final class LaravelMyLiteUser extends Model
{
    protected $table = 'framework_users';
    protected $guarded = [];
    protected $casts = ['score' => 'integer'];
    public $timestamps = false;

    public function posts(): HasMany
    {
        return $this->hasMany(LaravelMyLitePost::class, 'user_id');
    }
}

final class LaravelMyLitePost extends Model
{
    protected $table = 'framework_posts';
    protected $guarded = [];
    public $timestamps = false;

    public function user(): BelongsTo
    {
        return $this->belongsTo(LaravelMyLiteUser::class, 'user_id');
    }
}
PHP
}

remove_database_files() {
  rm -f \
    "${MYLITE_LARAVEL_DB_PATH}" \
    "${MYLITE_LARAVEL_DB_PATH}-journal" \
    "${MYLITE_LARAVEL_DB_PATH}-wal" \
    "${MYLITE_LARAVEL_DB_PATH}-shm"
}

build_laravel_phpunit_environment() {
  fetch_laravel_application
  build_mylite_php_extensions
  install_laravel_application_dependencies
}

phpunit_output_has_nonpassing_summary() {
  grep -Eq '^(FAILURES!|ERRORS!|No tests executed!|There (was|were) [0-9]+ (failure|failures|error|errors))' "$1"
}

run_laravel_phpunit_suite() {
  require_executable "${php_wrapper}"
  require_executable "${MYLITE_LARAVEL_DIR}/artisan"
  require_executable "${MYLITE_LARAVEL_DIR}/vendor/bin/phpunit"
  mkdir -p "${MYLITE_LARAVEL_CMAKE_BUILD_DIR}"
  write_laravel_application_suite

  if grep -Eq \
      'class[[:space:]]+[[:alnum:]_]*(Connector|Connection)|new[[:space:]]+(\\?PDO|MySqlConnection)|ConnectionResolver' \
      "${MYLITE_LARAVEL_SUITE_DIR}/LaravelMyLiteApplicationTest.php"; then
    printf '%s\n' "generated Laravel suite contains a test-local connection bridge" >&2
    return 1
  fi

  remove_database_files
  phase "Run Laravel migrations through configured MyLite driver"
  DB_CONNECTION=mylite \
    MYLITE_LARAVEL_DB_PATH="${MYLITE_LARAVEL_DB_PATH}" \
    MYLITE_LARAVEL_DATABASE=laravel_tests \
    "${php_wrapper}" "${MYLITE_LARAVEL_DIR}/artisan" migrate:fresh --force

  phase "Run Laravel application PHPUnit test suite"
  suite_log="${MYLITE_LARAVEL_CMAKE_BUILD_DIR}/laravel-phpunit.log"
  suite_start="$(date +%s)"
  set +e
  "${php_wrapper}" "${MYLITE_LARAVEL_DIR}/vendor/bin/phpunit" \
    -c "${MYLITE_LARAVEL_SUITE_DIR}/phpunit.xml" "$@" 2>&1 | tee "${suite_log}"
  suite_status="${PIPESTATUS[0]}"
  set -e
  if [ "${suite_status}" -eq 0 ] && phpunit_output_has_nonpassing_summary "${suite_log}"; then
    printf '%s\n' "PHPUnit reported a non-passing summary but exited with status 0" >&2
    suite_status=1
  fi
  echo "laravel_phpunit_seconds=$(seconds_since "${suite_start}")"
  return "${suite_status}"
}

case "${container_phase}" in
  fetch-laravel)
    fetch_laravel_application
    ;;
  build-extensions)
    build_mylite_php_extensions
    ;;
  install-dependencies)
    install_laravel_application_dependencies
    ;;
  build)
    build_laravel_phpunit_environment
    ;;
  test)
    run_laravel_phpunit_suite "$@"
    ;;
  *)
    printf 'unknown Laravel PHPUnit phase: %s\n' "${container_phase}" >&2
    exit 2
    ;;
esac
CONTAINER
}

command="run"
if [ "$#" -gt 0 ]; then
  case "$1" in
    image|fetch-laravel|build-extensions|install-dependencies|build|test|run)
      command="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown command: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
fi

overall_start="$(date +%s)"
overall_status=0
set +e
case "${command}" in
  image)
    build_image
    ;;
  fetch-laravel|build-extensions|install-dependencies)
    run_container "${command}"
    ;;
  build)
    build_image && run_container build
    ;;
  test)
    run_container test "$@"
    ;;
  run)
    build_image && run_container build && run_container test "$@"
    ;;
esac
overall_status="$?"
set -e
echo "laravel_overall_seconds=$(($(date +%s) - overall_start))"
exit "${overall_status}"
