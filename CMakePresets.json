{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MYLITE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "php-dev",
      "displayName": "Developer build with PHP extensions",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/php-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MYLITE_BUILD_PHP_EXTENSIONS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI release build",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-ci",
      "displayName": "CI assertion-enabled debug build",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/debug-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "php-ci",
      "displayName": "CI release build with PHP extensions",
      "inherits": "ci",
      "binaryDir": "${sourceDir}/build/php-ci",
      "cacheVariables": {
        "MYLITE_BUILD_PHP_EXTENSIONS": "ON"
      }
    },
    {
      "name": "production",
      "displayName": "Optimized production library",
      "inherits": "ci",
      "binaryDir": "${sourceDir}/build/production",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "MYLITE_BUILD_TOOLS": "OFF",
        "MYLITE_ENABLE_LTO": "OFF",
        "MYLITE_ENABLE_SECTION_GC": "ON"
      }
    },
    {
      "name": "php-production",
      "displayName": "Optimized production PHP extensions",
      "inherits": "production",
      "binaryDir": "${sourceDir}/build/php-production",
      "cacheVariables": {
        "MYLITE_BUILD_PHP_EXTENSIONS": "ON"
      }
    },
    {
      "name": "shared-abi",
      "displayName": "Optimized shared library ABI qualification",
      "inherits": "production",
      "binaryDir": "${sourceDir}/build/shared-abi",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "perf-profile",
      "displayName": "Release build with profiling instrumentation",
      "inherits": "ci",
      "binaryDir": "${sourceDir}/build/perf-profile",
      "cacheVariables": {
        "MYLITE_ENABLE_PROFILING": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Clang source coverage qualification",
      "inherits": "debug-ci",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "MYLITE_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "MYLITE_ENABLE_ASAN_UBSAN": "ON"
      }
    },
    {
      "name": "php-asan-ubsan",
      "displayName": "PHP extensions with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "asan-ubsan",
      "binaryDir": "${sourceDir}/build/php-asan-ubsan",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "MYLITE_BUILD_PHP_EXTENSIONS": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug build with ThreadSanitizer",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYLITE_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "fault-injection",
      "displayName": "Debug build with deterministic allocator failpoints",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/fault-injection",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYLITE_ENABLE_TEST_ALLOCATOR_FAILPOINTS": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Clang libFuzzer smoke qualification",
      "inherits": "asan-ubsan",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "MYLITE_BUILD_FUZZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "php-dev",
      "configurePreset": "php-dev"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "debug-ci",
      "configurePreset": "debug-ci"
    },
    {
      "name": "php-ci",
      "configurePreset": "php-ci"
    },
    {
      "name": "production",
      "configurePreset": "production"
    },
    {
      "name": "php-production",
      "configurePreset": "php-production"
    },
    {
      "name": "shared-abi",
      "configurePreset": "shared-abi"
    },
    {
      "name": "perf-profile",
      "configurePreset": "perf-profile"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "php-asan-ubsan",
      "configurePreset": "php-asan-ubsan",
      "targets": [
        "mylite_php_extension",
        "mylite_php_mysqli_extension",
        "mylite_php_pdo_extension"
      ]
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "fault-injection",
      "configurePreset": "fault-injection"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": [
        "mylite_fuzzers"
      ]
    },
    {
      "name": "format",
      "configurePreset": "dev",
      "targets": [
        "format"
      ]
    },
    {
      "name": "format-check",
      "configurePreset": "dev",
      "targets": [
        "format-check"
      ]
    },
    {
      "name": "tidy",
      "configurePreset": "dev",
      "targets": [
        "tidy"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "php-dev",
      "configurePreset": "php-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-ci",
      "configurePreset": "debug-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "php-ci",
      "configurePreset": "php-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "perf-profile",
      "configurePreset": "perf-profile",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/profiles/%p-%m.profraw"
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "php-asan-ubsan",
      "configurePreset": "php-asan-ubsan",
      "filter": {
        "include": {
          "name": "^php-ext"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1:strict_string_checks=1:verify_asan_link_order=0",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "filter": {
        "include": {
          "label": "concurrency"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "fault-injection",
      "configurePreset": "fault-injection",
      "filter": {
        "include": {
          "label": "fault-injection"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "filter": {
        "include": {
          "label": "fuzz"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "check",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "format-check"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "tidy"
        }
      ]
    }
  ]
}
