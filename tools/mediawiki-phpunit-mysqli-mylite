#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image="${MYLITE_MEDIAWIKI_DOCKER_IMAGE:-mylite-mediawiki-phpunit:php83}"
mediawiki_repo="${MYLITE_MEDIAWIKI_REPO:-https://github.com/wikimedia/mediawiki.git}"
mediawiki_ref="${MYLITE_MEDIAWIKI_REF:-REL1_42}"
mediawiki_dir="${MYLITE_MEDIAWIKI_DIR:-${root_dir}/build/mediawiki-core}"
cmake_build_dir="${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR:-${root_dir}/build/mediawiki-php-mylite}"
cmake_build_type="${MYLITE_MEDIAWIKI_CMAKE_BUILD_TYPE:-Release}"
db_path="${MYLITE_MEDIAWIKI_DB_PATH:-${root_dir}/build/mediawiki-tests.mylite}"
db_name="${MYLITE_MEDIAWIKI_DB_NAME:-mediawiki_tests}"
db_prefix="${MYLITE_MEDIAWIKI_DB_PREFIX:-mylite_mw_}"
container_root="/work"
container_mediawiki_dir="${container_root}${mediawiki_dir#"${root_dir}"}"
container_cmake_build_dir="${container_root}${cmake_build_dir#"${root_dir}"}"
container_db_path="${container_root}${db_path#"${root_dir}"}"

build_image() {
  docker build -t "${image}" - <<'DOCKERFILE'
FROM composer:2 AS composer
FROM php:8.3-cli-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libicu-dev \
    libpng-dev \
    libzip-dev \
    ninja-build \
    pkg-config \
    unzip \
    zlib1g-dev \
  && docker-php-ext-install -j"$(nproc)" calendar intl zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
DOCKERFILE
}

usage() {
  cat <<USAGE
usage: tools/mediawiki-phpunit-mysqli-mylite [command] [phpunit-args...]

Commands:
  image                 Build the Docker image.
  fetch-mediawiki       Fetch the MediaWiki core checkout.
  build-extensions      Build the MyLite PHP extensions and PHP wrapper.
  install-dependencies  Install MediaWiki PHPUnit dependencies.
  build                 Build the Docker image and full PHPUnit environment.
  test                  Run the MediaWiki database PHPUnit test suite.
  run                   Build the environment, then run the MediaWiki database PHPUnit test suite.
USAGE
}

run_container() {
  docker run --rm -i \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp/mylite-home \
    -e MYLITE_MEDIAWIKI_REPO="${mediawiki_repo}" \
    -e MYLITE_MEDIAWIKI_REF="${mediawiki_ref}" \
    -e MYLITE_MEDIAWIKI_DIR="${container_mediawiki_dir}" \
    -e MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR="${container_cmake_build_dir}" \
    -e MYLITE_MEDIAWIKI_CMAKE_BUILD_TYPE="${cmake_build_type}" \
    -e MYLITE_MEDIAWIKI_DB_PATH="${container_db_path}" \
    -e MYLITE_MEDIAWIKI_DB_NAME="${db_name}" \
    -e MYLITE_MEDIAWIKI_DB_PREFIX="${db_prefix}" \
    -e MW_INSTALL_PATH="${container_mediawiki_dir}" \
    -v "${root_dir}:${container_root}" \
    -w "${container_root}" \
    "${image}" \
    bash -s -- "$@" <<'CONTAINER'
set -euo pipefail

container_phase="${1:-run}"
if [ "$#" -gt 0 ]; then
  shift
fi
php_wrapper="${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR}/mylite-mediawiki-php"
mylite_extension="${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR}/packages/php-ext-mylite/mylite.so"
mysqli_extension="${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR}/packages/php-ext-mysqli-mylite/mysqli.so"
php_ini_dir="${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR}/php-conf.d"
mediawiki_db_host="localhost:${MYLITE_MEDIAWIKI_DB_PATH}"

phase() {
  printf '\n==> %s\n' "$*"
}

seconds_since() {
  local start="$1"
  local end
  end="$(date +%s)"
  echo "$((end - start))"
}

require_executable() {
  if [ ! -x "$1" ]; then
    printf '%s\n' "missing executable: $1" >&2
    printf '%s\n' "run tools/mediawiki-phpunit-mysqli-mylite build first" >&2
    exit 1
  fi
}

fetch_mediawiki_core() {
  mkdir -p "${HOME}" "$(dirname "${MYLITE_MEDIAWIKI_DIR}")"

  phase "Fetch MediaWiki core"
  local fetch_start
  fetch_start="$(date +%s)"
  if [ ! -d "${MYLITE_MEDIAWIKI_DIR}/.git" ]; then
    git init "${MYLITE_MEDIAWIKI_DIR}"
    git -C "${MYLITE_MEDIAWIKI_DIR}" remote add origin "${MYLITE_MEDIAWIKI_REPO}"
  fi
  git -C "${MYLITE_MEDIAWIKI_DIR}" fetch --depth 1 origin "${MYLITE_MEDIAWIKI_REF}"
  git -C "${MYLITE_MEDIAWIKI_DIR}" checkout --detach FETCH_HEAD
  mediawiki_sha="$(git -C "${MYLITE_MEDIAWIKI_DIR}" rev-parse HEAD)"
  echo "mediawiki_sha=${mediawiki_sha}"
  echo "mediawiki_fetch_seconds=$(seconds_since "${fetch_start}")"
}

build_mylite_php_extensions() {
  phase "Build MyLite PHP extensions"
  local build_start
  build_start="$(date +%s)"
  cmake -S . -B "${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR}" -G Ninja \
    -DCMAKE_BUILD_TYPE="${MYLITE_MEDIAWIKI_CMAKE_BUILD_TYPE}" \
    -DMYLITE_WARNINGS_AS_ERRORS=ON \
    -DMYLITE_BUILD_PHP_EXTENSIONS=ON \
    -DMYLITE_PHP_CONFIG_EXECUTABLE=/usr/local/bin/php-config \
    -DMYLITE_PHP_EXECUTABLE=/usr/local/bin/php
  cmake --build "${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR}" --target mylite_php_mysqli_extension
  mkdir -p "${php_ini_dir}"
  cat > "${php_ini_dir}/mylite.ini" <<INI
extension=${mylite_extension}
extension=${mysqli_extension}
INI
  cat > "${php_wrapper}" <<PHP
#!/usr/bin/env sh
export PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}"
exec /usr/local/bin/php "\$@"
PHP
  chmod +x "${php_wrapper}"
  "${php_wrapper}" -r 'if (!extension_loaded("mylite") || !extension_loaded("mysqli") || !function_exists("mysqli_connect")) { exit(1); }'
  echo "mylite_build_seconds=$(seconds_since "${build_start}")"
}

install_mediawiki_phpunit_dependencies() {
  mkdir -p "${HOME}"
  phase "Install MediaWiki PHPUnit dependencies"
  local deps_start
  deps_start="$(date +%s)"
  composer --working-dir="${MYLITE_MEDIAWIKI_DIR}" config policy.advisories.block false
  composer --working-dir="${MYLITE_MEDIAWIKI_DIR}" install --no-interaction --no-progress --prefer-dist
  echo "mediawiki_dependency_seconds=$(seconds_since "${deps_start}")"
}

prepare_mediawiki_database() {
  phase "Prepare MediaWiki MyLite database"
  rm -f \
    "${MYLITE_MEDIAWIKI_DB_PATH}" \
    "${MYLITE_MEDIAWIKI_DB_PATH}-journal" \
    "${MYLITE_MEDIAWIKI_DB_PATH}-wal" \
    "${MYLITE_MEDIAWIKI_DB_PATH}-shm" \
    "${MYLITE_MEDIAWIKI_DIR}/LocalSettings.php"
  "${php_wrapper}" -r '
$db = mysqli_connect($argv[1]);
if (!$db) {
    fwrite(STDERR, "connect failed: " . (mysqli_connect_error() ?? "") . PHP_EOL);
    exit(1);
}
if (!mysqli_query($db, "CREATE DATABASE IF NOT EXISTS `" . str_replace("`", "``", $argv[2]) . "`")) {
    fwrite(STDERR, "create database failed: " . mysqli_error($db) . PHP_EOL);
    exit(1);
}
mysqli_close($db);
' "${MYLITE_MEDIAWIKI_DB_PATH}" "${MYLITE_MEDIAWIKI_DB_NAME}"
}

install_mediawiki_database_schema() {
  phase "Install MediaWiki database schema"
  local install_start
  install_start="$(date +%s)"
  (
    cd "${MYLITE_MEDIAWIKI_DIR}"
    "${php_wrapper}" maintenance/run.php install "MyLite" "Admin" \
      --pass "mylite-password" \
      --server "http://localhost" \
      --scriptpath "" \
      --dbtype "mysql" \
      --dbserver "${mediawiki_db_host}" \
      --dbname "${MYLITE_MEDIAWIKI_DB_NAME}" \
      --dbprefix "${MYLITE_MEDIAWIKI_DB_PREFIX}" \
      --installdbuser "root" \
      --installdbpass "" \
      --dbuser "root" \
      --dbpass ""
  )
  echo "mediawiki_install_seconds=$(seconds_since "${install_start}")"
}

build_mediawiki_phpunit_environment() {
  fetch_mediawiki_core
  build_mylite_php_extensions
  install_mediawiki_phpunit_dependencies
}

phpunit_output_has_nonpassing_summary() {
  grep -Eq '^(FAILURES!|ERRORS!|No tests executed!|There (was|were) [0-9]+ (failure|failures|error|errors))' "$1"
}

run_mediawiki_phpunit_suite() {
  require_executable "${php_wrapper}"
  require_executable "${MYLITE_MEDIAWIKI_DIR}/vendor/bin/phpunit"
  mkdir -p "${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR}"

  prepare_mediawiki_database
  install_mediawiki_database_schema

  phase "Run MediaWiki database PHPUnit test suite"
  suite_log="${MYLITE_MEDIAWIKI_CMAKE_BUILD_DIR}/mediawiki-phpunit.log"
  suite_start="$(date +%s)"
  set +e
  (
    cd "${MYLITE_MEDIAWIKI_DIR}"
    if [ "$#" -eq 0 ]; then
      PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" composer phpunit -- \
        tests/phpunit/includes/db \
        tests/phpunit/structure/DatabaseIntegrationTest.php
    else
      PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" composer phpunit -- "$@"
    fi
  ) 2>&1 | tee "${suite_log}"
  suite_status="${PIPESTATUS[0]}"
  set -e
  if [ "${suite_status}" -eq 0 ] && phpunit_output_has_nonpassing_summary "${suite_log}"; then
    printf '%s\n' "PHPUnit reported a non-passing summary but exited with status 0" >&2
    suite_status=1
  fi
  echo "mediawiki_phpunit_seconds=$(seconds_since "${suite_start}")"
  return "${suite_status}"
}

case "${container_phase}" in
  fetch-mediawiki)
    fetch_mediawiki_core
    ;;
  build-extensions)
    build_mylite_php_extensions
    ;;
  install-dependencies)
    install_mediawiki_phpunit_dependencies
    ;;
  build)
    build_mediawiki_phpunit_environment
    ;;
  test)
    run_mediawiki_phpunit_suite "$@"
    ;;
  *)
    printf 'unknown MediaWiki PHPUnit phase: %s\n' "${container_phase}" >&2
    exit 2
    ;;
esac
CONTAINER
}

command="run"
if [ "$#" -gt 0 ]; then
  case "$1" in
    image|fetch-mediawiki|build-extensions|install-dependencies|build|test|run)
      command="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown command: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
fi

overall_start="$(date +%s)"
overall_status=0
set +e
case "${command}" in
  image)
    build_image
    ;;
  fetch-mediawiki|build-extensions|install-dependencies)
    run_container "${command}"
    ;;
  build)
    build_image
    run_container build
    ;;
  test)
    run_container test "$@"
    ;;
  run)
    build_image
    run_container build && run_container test "$@"
    ;;
  *)
    printf 'unknown command: %s\n' "${command}" >&2
    false
    ;;
esac
overall_status="$?"
set -e
overall_end="$(date +%s)"
echo "mediawiki_total_seconds=$((overall_end - overall_start))"
exit "${overall_status}"
