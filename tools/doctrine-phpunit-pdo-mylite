#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image="${MYLITE_DOCTRINE_DOCKER_IMAGE:-mylite-doctrine-phpunit:php84}"
dbal_version="${MYLITE_DOCTRINE_DBAL_VERSION:-4.4.3}"
orm_version="${MYLITE_DOCTRINE_ORM_VERSION:-3.6.7}"
app_dir="${MYLITE_DOCTRINE_APP_DIR:-${root_dir}/build/doctrine-mylite-application}"
suite_dir="${MYLITE_DOCTRINE_SUITE_DIR:-${root_dir}/build/doctrine-mylite-tests}"
cmake_build_dir="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR:-${root_dir}/build/doctrine-php-mylite}"
cmake_build_type="${MYLITE_DOCTRINE_CMAKE_BUILD_TYPE:-Release}"
dbal_db_path="${MYLITE_DOCTRINE_DBAL_DB_PATH:-${root_dir}/build/doctrine-dbal-tests.mylite}"
orm_db_path="${MYLITE_DOCTRINE_ORM_DB_PATH:-${root_dir}/build/doctrine-orm-tests.mylite}"
package_dir="${root_dir}/packages/php-doctrine-mylite"
container_root="/work"
container_app_dir="${container_root}${app_dir#"${root_dir}"}"
container_suite_dir="${container_root}${suite_dir#"${root_dir}"}"
container_cmake_build_dir="${container_root}${cmake_build_dir#"${root_dir}"}"
container_dbal_db_path="${container_root}${dbal_db_path#"${root_dir}"}"
container_orm_db_path="${container_root}${orm_db_path#"${root_dir}"}"
container_package_dir="${container_root}${package_dir#"${root_dir}"}"

build_image() {
  docker build -t "${image}" - <<'DOCKERFILE'
FROM composer:2@sha256:5946476338742b200bb9ff88f8be56275ddae4b3949c72305cb0dbf10cfcb760 AS composer
FROM php:8.4-cli-bookworm@sha256:138a210978c7767ef2a26f499c413fe6de1c13233c9a5068139565c81191b1ac

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libicu-dev \
    libzip-dev \
    ninja-build \
    pkg-config \
    unzip \
    zlib1g-dev \
  && docker-php-ext-install -j"$(nproc)" intl zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
DOCKERFILE
}

usage() {
  cat <<USAGE
usage: tools/doctrine-phpunit-pdo-mylite [command] [phpunit-args...]

Commands:
  image                   Build the Docker image.
  initialize-application  Create the fresh Composer application manifest.
  build-extensions        Build the MyLite PHP extensions and PHP wrapper.
  install-dependencies    Install Doctrine, the MyLite driver, and PHPUnit.
  build                   Build the Docker image and full PHPUnit environment.
  test                    Run the Doctrine DBAL and ORM PHPUnit suites.
  run                     Build the environment, then run both suites.
USAGE
}

run_container() {
  docker run --rm -i \
    --user "$(id -u):$(id -g)" \
    -e COMPOSER_HOME=/tmp/mylite-composer-home \
    -e MYLITE_DOCTRINE_DBAL_VERSION="${dbal_version}" \
    -e MYLITE_DOCTRINE_ORM_VERSION="${orm_version}" \
    -e MYLITE_DOCTRINE_APP_DIR="${container_app_dir}" \
    -e MYLITE_DOCTRINE_SUITE_DIR="${container_suite_dir}" \
    -e MYLITE_DOCTRINE_CMAKE_BUILD_DIR="${container_cmake_build_dir}" \
    -e MYLITE_DOCTRINE_CMAKE_BUILD_TYPE="${cmake_build_type}" \
    -e MYLITE_DOCTRINE_DBAL_DB_PATH="${container_dbal_db_path}" \
    -e MYLITE_DOCTRINE_ORM_DB_PATH="${container_orm_db_path}" \
    -e MYLITE_DOCTRINE_PACKAGE_DIR="${container_package_dir}" \
    -v "${root_dir}:${container_root}" \
    -w "${container_root}" \
    "${image}" \
    bash -s -- "$@" <<'CONTAINER'
set -euo pipefail

container_phase="${1:-run}"
if [ "$#" -gt 0 ]; then
  shift
fi
php_wrapper="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/mylite-doctrine-php"
mylite_extension="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/packages/php-ext-mylite/mylite.so"
pdo_extension="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/packages/php-ext-pdo-mylite/pdo_mylite.so"
php_ini_dir="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/php-conf.d"

phase() {
  printf '\n==> %s\n' "$*"
}

seconds_since() {
  local start="$1"
  local end
  end="$(date +%s)"
  echo "$((end - start))"
}

require_executable() {
  if [ ! -x "$1" ]; then
    printf '%s\n' "missing executable: $1" >&2
    printf '%s\n' "run tools/doctrine-phpunit-pdo-mylite build first" >&2
    exit 1
  fi
}

initialize_doctrine_application() {
  phase "Initialize fresh Doctrine Composer application"
  mkdir -p "${COMPOSER_HOME}" "${MYLITE_DOCTRINE_APP_DIR}"
  cat > "${MYLITE_DOCTRINE_APP_DIR}/composer.json" <<JSON
{
    "name": "mylite/doctrine-application-gate",
    "description": "Fresh application gate for the MyLite Doctrine DBAL driver",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "${MYLITE_DOCTRINE_PACKAGE_DIR}",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "${MYLITE_DOCTRINE_DBAL_VERSION}",
        "doctrine/orm": "${MYLITE_DOCTRINE_ORM_VERSION}",
        "mylite/doctrine-dbal-driver": "@dev",
        "symfony/cache": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "sort-packages": true
    }
}
JSON
  echo "doctrine_dbal_version=${MYLITE_DOCTRINE_DBAL_VERSION}"
  echo "doctrine_orm_version=${MYLITE_DOCTRINE_ORM_VERSION}"
}

build_mylite_php_extensions() {
  phase "Build MyLite PHP extensions"
  local build_start
  build_start="$(date +%s)"
  cmake -S . -B "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}" -G Ninja \
    -DCMAKE_BUILD_TYPE="${MYLITE_DOCTRINE_CMAKE_BUILD_TYPE}" \
    -DMYLITE_WARNINGS_AS_ERRORS=ON \
    -DMYLITE_BUILD_PHP_EXTENSIONS=ON \
    -DMYLITE_PHP_CONFIG_EXECUTABLE=/usr/local/bin/php-config \
    -DMYLITE_PHP_EXECUTABLE=/usr/local/bin/php
  cmake --build "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}" --target mylite_php_pdo_extension
  mkdir -p "${php_ini_dir}"
  cat > "${php_ini_dir}/mylite.ini" <<INI
extension=${mylite_extension}
extension=${pdo_extension}
INI
  cat > "${php_wrapper}" <<PHP
#!/usr/bin/env sh
export PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}"
exec /usr/local/bin/php "\$@"
PHP
  chmod +x "${php_wrapper}"
  "${php_wrapper}" -r 'if (!extension_loaded("mylite") || !extension_loaded("pdo_mylite") || !in_array("mylite", PDO::getAvailableDrivers(), true)) { exit(1); }'
  echo "mylite_build_seconds=$(seconds_since "${build_start}")"
}

install_doctrine_dependencies() {
  mkdir -p "${COMPOSER_HOME}"
  phase "Install Doctrine and MyLite driver package"
  local deps_start
  deps_start="$(date +%s)"
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_DOCTRINE_APP_DIR}" \
      install --no-interaction --no-progress --prefer-dist
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_DOCTRINE_APP_DIR}" show doctrine/dbal
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_DOCTRINE_APP_DIR}" show doctrine/orm
  PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}" \
    composer --working-dir="${MYLITE_DOCTRINE_APP_DIR}" show mylite/doctrine-dbal-driver
  echo "doctrine_dependency_seconds=$(seconds_since "${deps_start}")"
}

write_doctrine_phpunit_suite() {
  mkdir -p "${MYLITE_DOCTRINE_SUITE_DIR}"

  cat > "${MYLITE_DOCTRINE_SUITE_DIR}/dbal-phpunit.xml" <<XML
<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="${MYLITE_DOCTRINE_APP_DIR}/vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory="${MYLITE_DOCTRINE_SUITE_DIR}/.phpunit-dbal-cache">
  <testsuites>
    <testsuite name="Doctrine DBAL MyLite Application Test Suite">
      <file>${MYLITE_DOCTRINE_SUITE_DIR}/DoctrineDbalMyLiteTest.php</file>
    </testsuite>
  </testsuites>
  <php>
    <ini name="date.timezone" value="UTC"/>
    <ini name="memory_limit" value="1024M"/>
    <env name="MYLITE_DOCTRINE_DBAL_DB_PATH" value="${MYLITE_DOCTRINE_DBAL_DB_PATH}"/>
    <env name="MYLITE_DOCTRINE_PACKAGE_DIR" value="${MYLITE_DOCTRINE_PACKAGE_DIR}"/>
  </php>
</phpunit>
XML

  cat > "${MYLITE_DOCTRINE_SUITE_DIR}/orm-phpunit.xml" <<XML
<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="${MYLITE_DOCTRINE_APP_DIR}/vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory="${MYLITE_DOCTRINE_SUITE_DIR}/.phpunit-orm-cache">
  <testsuites>
    <testsuite name="Doctrine ORM MyLite Application Test Suite">
      <file>${MYLITE_DOCTRINE_SUITE_DIR}/DoctrineOrmMyLiteTest.php</file>
    </testsuite>
  </testsuites>
  <php>
    <ini name="date.timezone" value="UTC"/>
    <ini name="memory_limit" value="1024M"/>
    <env name="MYLITE_DOCTRINE_ORM_DB_PATH" value="${MYLITE_DOCTRINE_ORM_DB_PATH}"/>
    <env name="DOCTRINE_DEPRECATIONS" value="ignore"/>
  </php>
</phpunit>
XML

  cat > "${MYLITE_DOCTRINE_SUITE_DIR}/DoctrineDbalMyLiteTest.php" <<'PHP'
<?php

declare(strict_types=1);

namespace MyLiteDoctrineDbalSuite;

use Doctrine\DBAL\Connection;
use Doctrine\DBAL\DriverManager;
use Doctrine\DBAL\Exception\UniqueConstraintViolationException;
use Doctrine\DBAL\Platforms\MySQL84Platform;
use MyLite\Doctrine\DBAL\Driver;
use MyLite\Doctrine\DBAL\Exception\InvalidConfiguration;
use PHPUnit\Framework\TestCase;
use ReflectionClass;

final class DoctrineDbalMyLiteTest extends TestCase
{
    private Connection $connection;

    protected function setUp(): void
    {
        parent::setUp();

        $dbPath = getenv('MYLITE_DOCTRINE_DBAL_DB_PATH');
        self::assertIsString($dbPath);
        self::removeDatabaseFiles($dbPath);

        $this->connection = DriverManager::getConnection([
            'driverClass' => Driver::class,
            'path' => $dbPath,
            'dbname' => 'doctrine_dbal_tests',
        ]);
    }

    protected function tearDown(): void
    {
        $this->connection->close();
        parent::tearDown();
    }

    public function testInstalledDriverQueryMetadataExceptionsAndTransactions(): void
    {
        $packageDirectory = getenv('MYLITE_DOCTRINE_PACKAGE_DIR');
        self::assertIsString($packageDirectory);
        $driverFile = (new ReflectionClass(Driver::class))->getFileName();
        self::assertIsString($driverFile);
        self::assertStringStartsWith(realpath($packageDirectory).DIRECTORY_SEPARATOR, $driverFile);
        self::assertInstanceOf(MySQL84Platform::class, $this->connection->getDatabasePlatform());

        $this->connection->executeStatement(
            'CREATE TABLE doctrine_users ('.
            'id INT AUTO_INCREMENT PRIMARY KEY, '.
            'email VARCHAR(191) NOT NULL, '.
            'name VARCHAR(191) NOT NULL, '.
            'score INT NOT NULL DEFAULT 0, '.
            'UNIQUE KEY doctrine_users_email_unique (email)'.
            ')'
        );

        $this->connection->insert('doctrine_users', [
            'email' => 'first@example.test',
            'name' => 'First',
            'score' => 10,
        ]);
        self::assertSame('1', (string) $this->connection->lastInsertId());
        $this->connection->insert('doctrine_users', [
            'email' => 'second@example.test',
            'name' => 'Second',
            'score' => 20,
        ]);

        $rows = $this->connection->createQueryBuilder()
            ->select('email', 'score')
            ->from('doctrine_users')
            ->where('score >= :score')
            ->setParameter('score', 10)
            ->orderBy('score', 'DESC')
            ->executeQuery()
            ->fetchAllAssociative();
        self::assertSame('second@example.test', $rows[0]['email']);
        self::assertSame(20, $rows[0]['score']);
        self::assertSame('first@example.test', $rows[1]['email']);
        self::assertSame(10, $rows[1]['score']);

        try {
            $this->connection->insert('doctrine_users', [
                'email' => 'first@example.test',
                'name' => 'Duplicate',
                'score' => 0,
            ]);
            self::fail('Expected a duplicate-key exception.');
        } catch (UniqueConstraintViolationException $exception) {
            self::assertSame('23000', $exception->getSQLState());
        }

        $schemaManager = $this->connection->createSchemaManager();
        $columns = $schemaManager->listTableColumns('doctrine_users');
        self::assertArrayHasKey('id', $columns);
        self::assertArrayHasKey('email', $columns);
        $indexNames = array_map(
            static fn ($index): string => strtolower($index->getName()),
            $schemaManager->listTableIndexes('doctrine_users'),
        );
        self::assertContains('primary', $indexNames);
        self::assertContains('doctrine_users_email_unique', $indexNames);

        $this->connection->beginTransaction();
        $this->connection->insert('doctrine_users', [
            'email' => 'rolled-back@example.test',
            'name' => 'Rollback',
            'score' => 99,
        ]);
        $this->connection->rollBack();
        self::assertSame(
            0,
            (int) $this->connection->fetchOne(
                'SELECT COUNT(*) FROM doctrine_users WHERE email = ?',
                ['rolled-back@example.test'],
            ),
        );
    }

    public function testDriverRejectsInvalidConfiguration(): void
    {
        $cases = [
            [['path' => ''], 'nonempty string'],
            [['path' => "invalid\0path"], 'NUL bytes'],
            [['path' => ':memory:', 'dbname' => []], 'database must be a string'],
            [['path' => ':memory:', 'driverOptions' => 'invalid'], 'driverOptions must be an array'],
            [['path' => ':memory:', 'persistent' => true], 'persistent connections'],
        ];

        foreach ($cases as [$params, $message]) {
            try {
                (new Driver())->connect($params);
                self::fail('Expected invalid MyLite configuration to fail.');
            } catch (InvalidConfiguration $exception) {
                self::assertStringContainsString($message, $exception->getMessage());
            }
        }
    }

    private static function removeDatabaseFiles(string $path): void
    {
        @unlink($path);
        @unlink($path.'-journal');
        @unlink($path.'-wal');
        @unlink($path.'-shm');
    }
}
PHP

  cat > "${MYLITE_DOCTRINE_SUITE_DIR}/DoctrineOrmMyLiteTest.php" <<'PHP'
<?php

declare(strict_types=1);

namespace MyLiteDoctrineOrmSuite;

use Doctrine\DBAL\Connection;
use Doctrine\DBAL\DriverManager;
use Doctrine\ORM\EntityManager;
use Doctrine\ORM\Mapping as ORM;
use Doctrine\ORM\ORMSetup;
use Doctrine\ORM\Tools\SchemaTool;
use MyLite\Doctrine\DBAL\Driver;
use PHPUnit\Framework\TestCase;

#[ORM\Entity]
#[ORM\Table(name: 'orm_articles')]
class DoctrineOrmArticle
{
    #[ORM\Id]
    #[ORM\GeneratedValue]
    #[ORM\Column(type: 'integer')]
    public ?int $id = null;

    #[ORM\Column(type: 'string', length: 191)]
    public string $title;

    #[ORM\Column(type: 'string', length: 32)]
    public string $status;

    #[ORM\Column(type: 'integer')]
    public int $views;

    public function __construct(string $title, string $status, int $views)
    {
        $this->title = $title;
        $this->status = $status;
        $this->views = $views;
    }
}

final class DoctrineOrmMyLiteTest extends TestCase
{
    private Connection $connection;
    private EntityManager $entityManager;

    protected function setUp(): void
    {
        parent::setUp();

        $dbPath = getenv('MYLITE_DOCTRINE_ORM_DB_PATH');
        self::assertIsString($dbPath);
        self::removeDatabaseFiles($dbPath);

        $config = ORMSetup::createAttributeMetadataConfig([__DIR__], true);
        $config->enableNativeLazyObjects(true);
        $this->connection = DriverManager::getConnection([
            'driverClass' => Driver::class,
            'path' => $dbPath,
            'dbname' => 'doctrine_orm_tests',
        ]);
        $this->entityManager = new EntityManager($this->connection, $config);

        $schemaTool = new SchemaTool($this->entityManager);
        $schemaTool->createSchema([
            $this->entityManager->getClassMetadata(DoctrineOrmArticle::class),
        ]);
    }

    protected function tearDown(): void
    {
        $this->entityManager->close();
        $this->connection->close();
        parent::tearDown();
    }

    public function testEntityLifecycleDqlHydrationAndRollback(): void
    {
        $first = new DoctrineOrmArticle('First', 'published', 10);
        $second = new DoctrineOrmArticle('Second', 'draft', 20);
        $this->entityManager->persist($first);
        $this->entityManager->persist($second);
        $this->entityManager->flush();
        self::assertSame(1, $first->id);
        self::assertSame(2, $second->id);
        $this->entityManager->clear();

        $published = $this->entityManager
            ->createQuery('SELECT a FROM '.DoctrineOrmArticle::class.' a WHERE a.status = :status')
            ->setParameter('status', 'published')
            ->getSingleResult();
        self::assertInstanceOf(DoctrineOrmArticle::class, $published);
        self::assertSame('First', $published->title);
        self::assertSame(10, $published->views);

        $this->entityManager->beginTransaction();
        $draft = $this->entityManager->find(DoctrineOrmArticle::class, 2);
        self::assertInstanceOf(DoctrineOrmArticle::class, $draft);
        $this->entityManager->remove($draft);
        $this->entityManager->flush();
        $this->entityManager->rollback();
        $this->entityManager->clear();
        self::assertNotNull($this->entityManager->find(DoctrineOrmArticle::class, 2));
    }

    private static function removeDatabaseFiles(string $path): void
    {
        @unlink($path);
        @unlink($path.'-journal');
        @unlink($path.'-wal');
        @unlink($path.'-shm');
    }
}
PHP
}

build_doctrine_environment() {
  initialize_doctrine_application
  build_mylite_php_extensions
  install_doctrine_dependencies
}

phpunit_output_has_nonpassing_summary() {
  grep -Eq '^(FAILURES!|ERRORS!|No tests executed!|There (was|were) [0-9]+ (failure|failures|error|errors))' "$1"
}

run_phpunit_with_log_check() {
  local label="$1"
  local config="$2"
  local log="$3"
  shift 3

  local start
  start="$(date +%s)"
  set +e
  "${php_wrapper}" "${MYLITE_DOCTRINE_APP_DIR}/vendor/bin/phpunit" \
    -c "${config}" "$@" 2>&1 | tee "${log}"
  local status="${PIPESTATUS[0]}"
  set -e
  if [ "${status}" -eq 0 ] && phpunit_output_has_nonpassing_summary "${log}"; then
    printf '%s\n' "PHPUnit reported a non-passing summary but exited with status 0" >&2
    status=1
  fi
  echo "${label}_phpunit_seconds=$(seconds_since "${start}")"
  return "${status}"
}

run_doctrine_phpunit_suites() {
  require_executable "${php_wrapper}"
  require_executable "${MYLITE_DOCTRINE_APP_DIR}/vendor/bin/phpunit"
  mkdir -p "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}"
  write_doctrine_phpunit_suite

  if grep -Eq \
      'class[[:space:]]+[[:alnum:]_]*Driver|extends[[:space:]]+AbstractMySQLDriver|implements[^\\{]*Driver|new[[:space:]]+\\?PDO' \
      "${MYLITE_DOCTRINE_SUITE_DIR}"/*.php; then
    printf '%s\n' "generated Doctrine suite contains a test-local DBAL driver" >&2
    return 1
  fi

  phase "Run Doctrine DBAL application PHPUnit suite"
  run_phpunit_with_log_check \
    doctrine_dbal \
    "${MYLITE_DOCTRINE_SUITE_DIR}/dbal-phpunit.xml" \
    "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/doctrine-dbal-phpunit.log" \
    "$@"

  phase "Run Doctrine ORM application PHPUnit suite"
  run_phpunit_with_log_check \
    doctrine_orm \
    "${MYLITE_DOCTRINE_SUITE_DIR}/orm-phpunit.xml" \
    "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/doctrine-orm-phpunit.log" \
    "$@"
}

case "${container_phase}" in
  initialize-application)
    initialize_doctrine_application
    ;;
  build-extensions)
    build_mylite_php_extensions
    ;;
  install-dependencies)
    install_doctrine_dependencies
    ;;
  build)
    build_doctrine_environment
    ;;
  test)
    run_doctrine_phpunit_suites "$@"
    ;;
  *)
    printf 'unknown Doctrine PHPUnit phase: %s\n' "${container_phase}" >&2
    exit 2
    ;;
esac
CONTAINER
}

command="run"
if [ "$#" -gt 0 ]; then
  case "$1" in
    image|initialize-application|build-extensions|install-dependencies|build|test|run)
      command="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown command: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
fi

overall_start="$(date +%s)"
overall_status=0
set +e
case "${command}" in
  image)
    build_image
    ;;
  initialize-application|build-extensions|install-dependencies)
    run_container "${command}"
    ;;
  build)
    build_image && run_container build
    ;;
  test)
    run_container test "$@"
    ;;
  run)
    build_image && run_container build && run_container test "$@"
    ;;
esac
overall_status="$?"
set -e
echo "doctrine_overall_seconds=$(($(date +%s) - overall_start))"
exit "${overall_status}"
