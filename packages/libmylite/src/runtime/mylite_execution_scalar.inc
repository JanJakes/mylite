        return MYLITE_OK;
    case MYLITE_EXECUTION_SYSTEM_VARIABLE_INFORMATION_SCHEMA_STATS_EXPIRY:
        if (system_variable_expression_has_global_scope(expression)) {
            out_value->integer = information_schema_stats_expiry_default_value;
