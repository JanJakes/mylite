#!/bin/sh

set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/mylite-large-performance-tools.XXXXXX")
trap 'rm -rf "$temporary_directory"' EXIT HUP INT TERM

cat > "$temporary_directory/native.csv" <<'EOF'
record,scenario,rows,engine,mode,sample,iterations,result_rows,value_bytes,checksum,total_ms,avg_us,ops_per_sec,ratio
sample,point_lookup,1000,mylite,prepared,1,5,5,40,10,0.050,10.000,100000.000,0.000
summary,point_lookup,1000,mylite,prepared,0,5,0,0,0,0.050,10.000,100000.000,2.000
summary,point_lookup,1000,sqlite,prepared,0,5,0,0,0,0.025,5.000,200000.000,1.000
EOF

cat > "$temporary_directory/system.csv" <<'EOF'
scenario,rows,engine,workers,iterations,operations,errors,checksum,total_ms,avg_us,ops_per_sec,bytes_before,bytes_after_delete,bytes_after_reclaim
parallel_readers,1000,mylite,4,5,20,0,42,0.400,20.000,50000.000,0,0,0
parallel_readers,1000,sqlite,4,5,20,0,42,0.200,10.000,100000.000,0,0,0
EOF

"$root/tools/summarize-large-dataset-performance" \
  "$temporary_directory/native.csv" \
  "$temporary_directory/system.csv" \
  --output-dir "$temporary_directory/output"
grep -q 'point_lookup[[:space:]]1000[[:space:]]10.000[[:space:]]5.000[[:space:]]2.000000' \
  "$temporary_directory/output/native-summary.tsv"
grep -q 'parallel_readers[[:space:]]1000[[:space:]]20.000[[:space:]]10.000[[:space:]]2.000000' \
  "$temporary_directory/output/system-summary.tsv"

head -2 "$temporary_directory/native.csv" > "$temporary_directory/incomplete-native.csv"
if "$root/tools/summarize-large-dataset-performance" \
  "$temporary_directory/incomplete-native.csv" \
  "$temporary_directory/system.csv" \
  --output-dir "$temporary_directory/incomplete-output" >/dev/null 2>&1; then
  echo "test-large-dataset-performance-tools: accepted an incomplete engine pair" >&2
  exit 1
fi

sed 's/,0,42,/,1,42,/' \
  "$temporary_directory/system.csv" > "$temporary_directory/error-system.csv"
if "$root/tools/summarize-large-dataset-performance" \
  "$temporary_directory/native.csv" \
  "$temporary_directory/error-system.csv" \
  --output-dir "$temporary_directory/error-output" >/dev/null 2>&1; then
  echo "test-large-dataset-performance-tools: accepted system benchmark errors" >&2
  exit 1
fi

printf '%s\n' 'test-large-dataset-performance-tools: passed'
