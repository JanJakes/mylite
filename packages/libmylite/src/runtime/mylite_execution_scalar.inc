        database,
        child_at(expression, 0U),
        &value_cell,
        &owned_value,
        &value,
        &value_length,
        &value_is_null
    );
    if (rc == MYLITE_OK && argument_count == 2U) {
        rc = evaluate_string_trim_scalar_argument(
            database,
            child_at(expression, 1U),
            &remove_cell,
            &owned_remove,
            &remove_string,
            &remove_string_length,
            &remove_is_null
        );
    }
    if (rc != MYLITE_OK || value_is_null || remove_is_null) {
        free(owned_value);
