build_doctrine_phpunit_environment() {
  fetch_doctrine_checkouts
  build_mylite_php_extensions
  install_doctrine_phpunit_dependencies
}

phpunit_output_has_nonpassing_summary() {
  grep -Eq '^(FAILURES!|ERRORS!|No tests executed!|There (was|were) [0-9]+ (failure|failures|error|errors))' "$1"
}

run_phpunit_with_log_check() {
  local label="$1"
  local phpunit="$2"
  local config="$3"
  local log="$4"
  shift 4

  local start
  start="$(date +%s)"
  set +e
  "${php_wrapper}" "${phpunit}" -c "${config}" "$@" 2>&1 | tee "${log}"
  local status="${PIPESTATUS[0]}"
  set -e
  if [ "${status}" -eq 0 ] && phpunit_output_has_nonpassing_summary "${log}"; then
    printf '%s\n' "PHPUnit reported a non-passing summary but exited with status 0" >&2
    status=1
  fi
  echo "${label}_phpunit_seconds=$(seconds_since "${start}")"
  return "${status}"
}

run_doctrine_phpunit_suite() {
  require_executable "${php_wrapper}"
  require_executable "${MYLITE_DOCTRINE_DBAL_DIR}/vendor/bin/phpunit"
  require_executable "${MYLITE_DOCTRINE_ORM_DIR}/vendor/bin/phpunit"
  mkdir -p "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}"
  write_doctrine_phpunit_suite

  phase "Run Doctrine DBAL PHPUnit test suite"
  run_phpunit_with_log_check \
    doctrine_dbal \
    "${MYLITE_DOCTRINE_DBAL_DIR}/vendor/bin/phpunit" \
    "${MYLITE_DOCTRINE_SUITE_DIR}/dbal-phpunit.xml" \
    "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/doctrine-dbal-phpunit.log" \
    "$@"

  phase "Run Doctrine ORM PHPUnit test suite"
  run_phpunit_with_log_check \
    doctrine_orm \
    "${MYLITE_DOCTRINE_ORM_DIR}/vendor/bin/phpunit" \
    "${MYLITE_DOCTRINE_SUITE_DIR}/orm-phpunit.xml" \
    "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/doctrine-orm-phpunit.log" \
    "$@"
}

case "${container_phase}" in
  fetch-doctrine)
    fetch_doctrine_checkouts
    ;;
  build-extensions)
    build_mylite_php_extensions
    ;;
  install-dependencies)
    install_doctrine_phpunit_dependencies
    ;;
  build)
    build_doctrine_phpunit_environment
    ;;
  test)
    run_doctrine_phpunit_suite "$@"
    ;;
  *)
    printf 'unknown Doctrine PHPUnit phase: %s\n' "${container_phase}" >&2
    exit 2
    ;;
esac
CONTAINER
}

command="run"
if [ "$#" -gt 0 ]; then
  case "$1" in
    image|fetch-doctrine|build-extensions|install-dependencies|build|test|run)
      command="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown command: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
fi

overall_start="$(date +%s)"
overall_status=0
set +e
case "${command}" in
  image)
    build_image
    ;;
  fetch-doctrine|build-extensions|install-dependencies)
    run_container "${command}"
    ;;
  build)
    build_image
    run_container build
    ;;
  test)
    run_container test "$@"
    ;;
  run)
    build_image
    run_container build && run_container test "$@"
    ;;
  *)
    printf 'unknown command: %s\n' "${command}" >&2
    false
    ;;
esac
overall_status="$?"
set -e
overall_end="$(date +%s)"
echo "doctrine_total_seconds=$((overall_end - overall_start))"
exit "${overall_status}"
