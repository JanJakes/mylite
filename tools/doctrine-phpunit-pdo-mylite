<?php

declare(strict_types=1);

namespace MyLiteDoctrineDbalSuite;

use Doctrine\DBAL\Connection;
use Doctrine\DBAL\Driver\AbstractMySQLDriver;
use Doctrine\DBAL\Driver\PDO\Connection as PdoConnection;
use Doctrine\DBAL\Driver\PDO\Exception as PdoException;
use Doctrine\DBAL\DriverManager;
use PHPUnit\Framework\TestCase;
use SensitiveParameter;

final class MyLiteDbalDriver extends AbstractMySQLDriver
{
    public function connect(#[SensitiveParameter] array $params): PdoConnection
    {
        try {
            $pdo = new \PDO('mylite:' . ($params['path'] ?? ':memory:'), null, null, [
                \PDO::ATTR_ERRMODE => \PDO::ERRMODE_EXCEPTION,
                \PDO::ATTR_DEFAULT_FETCH_MODE => \PDO::FETCH_ASSOC,
            ]);

            if (isset($params['dbname']) && $params['dbname'] !== '') {
                $database = self::quoteIdentifier((string) $params['dbname']);
                $pdo->exec('CREATE DATABASE IF NOT EXISTS ' . $database);
                $pdo->exec('USE ' . $database);
            }

            return new PdoConnection($pdo);
        } catch (\PDOException $exception) {
            throw PdoException::new($exception);
        }
    }

    private static function quoteIdentifier(string $value): string
    {
        return '`' . str_replace('`', '``', $value) . '`';
    }
}

final class DoctrineDbalMyLiteTest extends TestCase
{
    private Connection $connection;

    protected function setUp(): void
    {
        parent::setUp();

        $dbPath = getenv('MYLITE_DOCTRINE_DBAL_DB_PATH');
        self::assertIsString($dbPath);
        @unlink($dbPath);
        @unlink($dbPath . '-journal');
        @unlink($dbPath . '-wal');
        @unlink($dbPath . '-shm');

        $this->connection = DriverManager::getConnection([
            'driverClass' => MyLiteDbalDriver::class,
            'path' => $dbPath,
            'dbname' => 'doctrine_dbal_tests',
            'serverVersion' => '8.4.9',
        ]);
    }

    protected function tearDown(): void
    {
        $this->connection->close();
        parent::tearDown();
    }

    public function testQueryBuilderSchemaManagerAndTransactions(): void
    {
        $this->connection->executeStatement(
            'CREATE TABLE doctrine_users (' .
            'id INT AUTO_INCREMENT PRIMARY KEY, ' .
            'email VARCHAR(191) NOT NULL, ' .
            'name VARCHAR(191) NOT NULL, ' .
            'score INT NOT NULL DEFAULT 0, ' .
            'UNIQUE KEY doctrine_users_email_unique (email)' .
            ')'
        );

        $this->connection->insert('doctrine_users', [
            'email' => 'first@example.test',
            'name' => 'First',
            'score' => 10,
        ]);
        self::assertSame('1', (string) $this->connection->lastInsertId());

        $this->connection->insert('doctrine_users', [
            'email' => 'second@example.test',
            'name' => 'Second',
            'score' => 20,
        ]);

        $rows = $this->connection->createQueryBuilder()
            ->select('email', 'score')
            ->from('doctrine_users')
            ->where('score >= :score')
            ->setParameter('score', 10)
            ->orderBy('score', 'DESC')
            ->executeQuery()
            ->fetchAllAssociative();

        self::assertSame('second@example.test', $rows[0]['email']);
        self::assertSame('first@example.test', $rows[1]['email']);

        $schemaManager = $this->connection->createSchemaManager();
        $columns = $schemaManager->listTableColumns('doctrine_users');
        self::assertArrayHasKey('id', $columns);
        self::assertArrayHasKey('email', $columns);

        $indexNames = array_map(
            static fn ($index): string => strtolower($index->getName()),
            $schemaManager->listTableIndexes('doctrine_users'),
        );
        self::assertContains('primary', $indexNames);
        self::assertContains('doctrine_users_email_unique', $indexNames);

        $this->connection->beginTransaction();
        $this->connection->insert('doctrine_users', [
            'email' => 'rolled-back@example.test',
            'name' => 'Rollback',
            'score' => 99,
        ]);
        $this->connection->rollBack();

        self::assertSame(
            0,
            (int) $this->connection->fetchOne(
                'SELECT COUNT(*) FROM doctrine_users WHERE email = ?',
                ['rolled-back@example.test'],
            ),
        );
    }
}
PHP

