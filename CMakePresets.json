{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MYLITE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "php-dev",
      "displayName": "Developer build with PHP extensions",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/php-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MYLITE_BUILD_PHP_EXTENSIONS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI release build",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "php-ci",
      "displayName": "CI release build with PHP extensions",
      "inherits": "ci",
      "binaryDir": "${sourceDir}/build/php-ci",
      "cacheVariables": {
        "MYLITE_BUILD_PHP_EXTENSIONS": "ON"
      }
    },
    {
      "name": "perf-profile",
      "displayName": "Release build with profiling instrumentation",
      "inherits": "ci",
      "binaryDir": "${sourceDir}/build/perf-profile",
      "cacheVariables": {
        "MYLITE_ENABLE_PROFILING": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYLITE_ENABLE_ASAN_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug build with ThreadSanitizer",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYLITE_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "php-dev",
      "configurePreset": "php-dev"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "php-ci",
      "configurePreset": "php-ci"
    },
    {
      "name": "perf-profile",
      "configurePreset": "perf-profile"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "format",
      "configurePreset": "dev",
      "targets": [
        "format"
      ]
    },
    {
      "name": "format-check",
      "configurePreset": "dev",
      "targets": [
        "format-check"
      ]
    },
    {
      "name": "tidy",
      "configurePreset": "dev",
      "targets": [
        "tidy"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "php-dev",
      "configurePreset": "php-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "php-ci",
      "configurePreset": "php-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "perf-profile",
      "configurePreset": "perf-profile",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "filter": {
        "include": {
          "label": "concurrency"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "check",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "format-check"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "tidy"
        }
      ]
    }
  ]
}
