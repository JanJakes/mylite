#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image="${MYLITE_DOCTRINE_DOCKER_IMAGE:-mylite-doctrine-phpunit:php84}"
dbal_repo="${MYLITE_DOCTRINE_DBAL_REPO:-https://github.com/doctrine/dbal.git}"
dbal_ref="${MYLITE_DOCTRINE_DBAL_REF:-61e730f1658814821a85f2402c945f3883407dec}"
orm_repo="${MYLITE_DOCTRINE_ORM_REPO:-https://github.com/doctrine/orm.git}"
orm_ref="${MYLITE_DOCTRINE_ORM_REF:-bc217c0e19c3a9eadfa67697143b87c9ba01272c}"
dbal_dir="${MYLITE_DOCTRINE_DBAL_DIR:-${root_dir}/build/doctrine-dbal}"
orm_dir="${MYLITE_DOCTRINE_ORM_DIR:-${root_dir}/build/doctrine-orm}"
suite_dir="${MYLITE_DOCTRINE_SUITE_DIR:-${root_dir}/build/doctrine-mylite-tests}"
cmake_build_dir="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR:-${root_dir}/build/doctrine-php-mylite}"
cmake_build_type="${MYLITE_DOCTRINE_CMAKE_BUILD_TYPE:-Release}"
dbal_db_path="${MYLITE_DOCTRINE_DBAL_DB_PATH:-${root_dir}/build/doctrine-dbal-tests.mylite}"
orm_db_path="${MYLITE_DOCTRINE_ORM_DB_PATH:-${root_dir}/build/doctrine-orm-tests.mylite}"
container_root="/work"
container_dbal_dir="${container_root}${dbal_dir#"${root_dir}"}"
container_orm_dir="${container_root}${orm_dir#"${root_dir}"}"
container_suite_dir="${container_root}${suite_dir#"${root_dir}"}"
container_cmake_build_dir="${container_root}${cmake_build_dir#"${root_dir}"}"
container_dbal_db_path="${container_root}${dbal_db_path#"${root_dir}"}"
container_orm_db_path="${container_root}${orm_db_path#"${root_dir}"}"

build_image() {
  docker build -t "${image}" - <<'DOCKERFILE'
FROM composer:2@sha256:5946476338742b200bb9ff88f8be56275ddae4b3949c72305cb0dbf10cfcb760 AS composer
FROM php:8.4-cli-bookworm@sha256:138a210978c7767ef2a26f499c413fe6de1c13233c9a5068139565c81191b1ac

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libicu-dev \
    libzip-dev \
    ninja-build \
    pkg-config \
    unzip \
    zlib1g-dev \
  && docker-php-ext-install -j"$(nproc)" intl zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
DOCKERFILE
}

usage() {
  cat <<USAGE
usage: tools/doctrine-phpunit-pdo-mylite [command] [phpunit-args...]

Commands:
  image                 Build the Docker image.
  fetch-doctrine        Fetch the Doctrine DBAL and ORM checkouts.
  build-extensions      Build the MyLite PHP extensions and PHP wrapper.
  install-dependencies  Install Doctrine and PHPUnit dependencies.
  build                 Build the Docker image and full PHPUnit environment.
  test                  Run the Doctrine DBAL and ORM PHPUnit test suite.
  run                   Build the environment, then run the Doctrine DBAL and ORM PHPUnit test suite.
USAGE
}

run_container() {
  docker run --rm -i \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp/mylite-home \
    -e MYLITE_DOCTRINE_DBAL_REPO="${dbal_repo}" \
    -e MYLITE_DOCTRINE_DBAL_REF="${dbal_ref}" \
    -e MYLITE_DOCTRINE_ORM_REPO="${orm_repo}" \
    -e MYLITE_DOCTRINE_ORM_REF="${orm_ref}" \
    -e MYLITE_DOCTRINE_DBAL_DIR="${container_dbal_dir}" \
    -e MYLITE_DOCTRINE_ORM_DIR="${container_orm_dir}" \
    -e MYLITE_DOCTRINE_SUITE_DIR="${container_suite_dir}" \
    -e MYLITE_DOCTRINE_CMAKE_BUILD_DIR="${container_cmake_build_dir}" \
    -e MYLITE_DOCTRINE_CMAKE_BUILD_TYPE="${cmake_build_type}" \
    -e MYLITE_DOCTRINE_DBAL_DB_PATH="${container_dbal_db_path}" \
    -e MYLITE_DOCTRINE_ORM_DB_PATH="${container_orm_db_path}" \
    -v "${root_dir}:${container_root}" \
    -w "${container_root}" \
    "${image}" \
    bash -s -- "$@" <<'CONTAINER'
set -euo pipefail

container_phase="${1:-run}"
if [ "$#" -gt 0 ]; then
  shift
fi
php_wrapper="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/mylite-doctrine-php"
mylite_extension="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/packages/php-ext-mylite/mylite.so"
pdo_extension="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/packages/php-ext-pdo-mylite/pdo_mylite.so"
php_ini_dir="${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}/php-conf.d"

phase() {
  printf '\n==> %s\n' "$*"
}

seconds_since() {
  local start="$1"
  local end
  end="$(date +%s)"
  echo "$((end - start))"
}

require_executable() {
  if [ ! -x "$1" ]; then
    printf '%s\n' "missing executable: $1" >&2
    printf '%s\n' "run tools/doctrine-phpunit-pdo-mylite build first" >&2
    exit 1
  fi
}

fetch_git_checkout() {
  local dir="$1"
  local repo="$2"
  local ref="$3"
  local label="$4"

  mkdir -p "${HOME}" "$(dirname "${dir}")"
  if [ ! -d "${dir}/.git" ]; then
    git init "${dir}"
    git -C "${dir}" remote add origin "${repo}"
  fi
  git -C "${dir}" fetch --depth 1 origin "${ref}"
  git -C "${dir}" checkout --detach FETCH_HEAD
  local sha
  sha="$(git -C "${dir}" rev-parse HEAD)"
  echo "${label}_sha=${sha}"
}

fetch_doctrine_checkouts() {
  phase "Fetch Doctrine checkouts"
  local fetch_start
  fetch_start="$(date +%s)"
  fetch_git_checkout "${MYLITE_DOCTRINE_DBAL_DIR}" "${MYLITE_DOCTRINE_DBAL_REPO}" "${MYLITE_DOCTRINE_DBAL_REF}" doctrine_dbal
  fetch_git_checkout "${MYLITE_DOCTRINE_ORM_DIR}" "${MYLITE_DOCTRINE_ORM_REPO}" "${MYLITE_DOCTRINE_ORM_REF}" doctrine_orm
  echo "doctrine_fetch_seconds=$(seconds_since "${fetch_start}")"
}

build_mylite_php_extensions() {
  phase "Build MyLite PHP extensions"
  local build_start
  build_start="$(date +%s)"
  cmake -S . -B "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}" -G Ninja \
    -DCMAKE_BUILD_TYPE="${MYLITE_DOCTRINE_CMAKE_BUILD_TYPE}" \
    -DMYLITE_WARNINGS_AS_ERRORS=ON \
    -DMYLITE_BUILD_PHP_EXTENSIONS=ON \
    -DMYLITE_PHP_CONFIG_EXECUTABLE=/usr/local/bin/php-config \
    -DMYLITE_PHP_EXECUTABLE=/usr/local/bin/php
  cmake --build "${MYLITE_DOCTRINE_CMAKE_BUILD_DIR}" --target mylite_php_pdo_extension
  mkdir -p "${php_ini_dir}"
  cat > "${php_ini_dir}/mylite.ini" <<INI
extension=${mylite_extension}
extension=${pdo_extension}
INI
  cat > "${php_wrapper}" <<PHP
#!/usr/bin/env sh
export PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}"
exec /usr/local/bin/php "\$@"
PHP
  chmod +x "${php_wrapper}"
  "${php_wrapper}" -r 'if (!extension_loaded("mylite") || !extension_loaded("pdo_mylite") || !in_array("mylite", PDO::getAvailableDrivers(), true)) { exit(1); }'
  echo "mylite_build_seconds=$(seconds_since "${build_start}")"
}

install_doctrine_phpunit_dependencies() {
  mkdir -p "${HOME}"
  phase "Install Doctrine PHPUnit dependencies"
  local deps_start
  deps_start="$(date +%s)"
  composer --working-dir="${MYLITE_DOCTRINE_DBAL_DIR}" install --no-interaction --no-progress --prefer-dist
  composer --working-dir="${MYLITE_DOCTRINE_ORM_DIR}" install --no-interaction --no-progress --prefer-dist
  echo "doctrine_dependency_seconds=$(seconds_since "${deps_start}")"
}

