#!/bin/sh

set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/mylite-release-tools.XXXXXX")
trap 'rm -rf "$temporary_directory"' EXIT HUP INT TERM

mkdir -p "$temporary_directory/first" "$temporary_directory/second" "$temporary_directory/metadata"
printf '%s\n' artifact > "$temporary_directory/first/mylite-0.1.0-test.tar.gz"
cp "$temporary_directory/first/mylite-0.1.0-test.tar.gz" "$temporary_directory/second/"

"$root/tools/verify-release-reproducibility" \
  "$temporary_directory/first" "$temporary_directory/second" \
  --output "$temporary_directory/reproducibility.json" >/dev/null

"$root/tools/generate-release-metadata" \
  --artifacts-dir "$temporary_directory/first" \
  --output-dir "$temporary_directory/metadata" \
  --version 0.1.0 \
  --commit 0123456789abcdef0123456789abcdef01234567 \
  --source-date-epoch 1700000000 >/dev/null

python3 - "$temporary_directory" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
reproducibility = json.loads((root / "reproducibility.json").read_text())
manifest = json.loads((root / "metadata/release-manifest.json").read_text())
sbom = json.loads((root / "metadata/mylite-0.1.0.spdx.json").read_text())
provenance = json.loads((root / "metadata/mylite-0.1.0.provenance.json").read_text())
assert reproducibility["artifacts"][0]["reproducible"] is True
assert manifest["artifacts"][0]["name"] == "mylite-0.1.0-test.tar.gz"
assert sbom["spdxVersion"] == "SPDX-2.3"
assert all(package["licenseDeclared"] == "NOASSERTION" for package in sbom["packages"])
assert provenance["predicateType"] == "https://slsa.dev/provenance/v1"
PY

printf '%s\n' changed > "$temporary_directory/second/mylite-0.1.0-test.tar.gz"
if "$root/tools/verify-release-reproducibility" \
  "$temporary_directory/first" "$temporary_directory/second" \
  --output "$temporary_directory/mismatch.json" >/dev/null 2>&1; then
  echo "test-release-tools: accepted mismatched release archives" >&2
  exit 1
fi

"$root/tools/build-release-bundles" --help >/dev/null
"$root/tools/test-release-bundles" --help >/dev/null
printf '%s\n' 'test-release-tools: passed'
