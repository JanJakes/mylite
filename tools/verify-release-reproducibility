#!/usr/bin/env python3

import argparse
import hashlib
import json
import sys
from pathlib import Path


def digest(path):
    checksum = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            checksum.update(block)
    return checksum.hexdigest()


def fail(message):
    print("verify-release-reproducibility: {}".format(message), file=sys.stderr)
    return 1


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("first", type=Path)
    parser.add_argument("second", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    options = parser.parse_args()

    try:
        first = {path.name: path for path in options.first.glob("*.tar.gz")}
        second = {path.name: path for path in options.second.glob("*.tar.gz")}
        if not first or set(first) != set(second):
            raise RuntimeError("release archive sets differ or are empty")
        records = []
        for name in sorted(first):
            first_digest = digest(first[name])
            second_digest = digest(second[name])
            if first_digest != second_digest:
                raise RuntimeError("{} is not reproducible".format(name))
            records.append({"name": name, "sha256": first_digest, "reproducible": True})
        options.output.parent.mkdir(parents=True, exist_ok=True)
        options.output.write_text(
            json.dumps({"artifacts": records}, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
    except (OSError, RuntimeError) as error:
        return fail(str(error))

    print("verify-release-reproducibility: {} archives match".format(len(records)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
