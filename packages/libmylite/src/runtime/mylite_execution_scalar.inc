        database,
        string_trim_function_to_value_kind(function_kind),
        value,
        value_length,
        remove_string,
        remove_string_length,
        &out_cell->owned_text
    );
    if (rc == MYLITE_NOMEM) {
        set_nomem_error(database);
    } else if (rc == MYLITE_OK) {
