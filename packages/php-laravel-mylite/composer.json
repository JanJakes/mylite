{
    "name": "mylite/laravel-driver",
    "description": "Laravel database connector for the MyLite PDO driver",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-mylite": "*",
        "ext-pdo": "*",
        "ext-pdo_mylite": "*",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "MyLite\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MyLite\\Laravel\\MyLiteServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
