        &datetime_is_null
    );
    if (rc == MYLITE_OK) {
        rc = evaluate_convert_tz_scalar_text_argument(
            database,
            child_at(expression, 1U),
            "CONVERT_TZ",
            &from_tz_text,
            &from_tz_length,
            &from_tz_is_null
        );
    }
    if (rc == MYLITE_OK) {
        rc = evaluate_convert_tz_scalar_text_argument(
            database,
            child_at(expression, 2U),
            "CONVERT_TZ",
            &to_tz_text,
            &to_tz_length,
            &to_tz_is_null
        );
    }
    if (rc == MYLITE_OK) {
        rc = mylite_convert_tz_value(
            database,
            datetime_text,
            datetime_length,
            datetime_is_null,
            from_tz_text,
            from_tz_length,
            from_tz_is_null,
            to_tz_text,
            to_tz_length,
            to_tz_is_null,
            &out_cell->owned_text,
            &result_is_null
        );
    }
    if (rc == MYLITE_OK && !result_is_null) {
        out_cell->value = out_cell->owned_text;
    }

    free(datetime_text);
    free(from_tz_text);
    free(to_tz_text);
    return rc;
}

static int evaluate_from_unixtime_scalar_argument(
