#!/usr/bin/env sh

set -eu

ROOT_DIR=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
MYSQL_CONTAINER="${MYLITE_MYSQL_CONTAINER:-mylite-mysql-849}"
MYSQL_RESET_TOOL="${MYLITE_MYSQL_RESET_TOOL:-$ROOT_DIR/tools/reset-mysql-runtime}"
MANIFEST="${MYLITE_MYSQL_EXPECTATIONS_MANIFEST:-$ROOT_DIR/tools/mysql-runtime-expectations-ci.txt}"
SHARD_INDEX="${MYLITE_MYSQL_EXPECTATIONS_SHARD_INDEX:-}"
SHARD_COUNT="${MYLITE_MYSQL_EXPECTATIONS_SHARD_COUNT:-}"

failures=0
total=0
manifest_script_index=0

fail() {
    printf '%s\n' "run-mysql-runtime-expectations: $1" >&2
    exit 1
}

verify_mysql_runtime() {
    if ! version=$(
        printf '%s\n' "SELECT VERSION();" \
            | docker exec -i "$MYSQL_CONTAINER" mysql --protocol=TCP -h127.0.0.1 -uroot \
                --batch --raw --skip-column-names
    ); then
        printf '%s\n' "could not query MySQL runtime version" >&2
        return 1
    fi
    case "$version" in
        8.4.9*) return 0 ;;
        *)
            printf '%s\n' "expected MySQL 8.4.9 runtime, got [$version]" >&2
            return 1
            ;;
    esac
}

validate_shard_configuration() {
    if [ -z "$SHARD_INDEX" ] && [ -z "$SHARD_COUNT" ]; then
        return
    fi
    case "$SHARD_INDEX" in
        '' | *[!0-9]*) fail "shard index must be a nonnegative integer" ;;
    esac
    case "$SHARD_COUNT" in
        '' | *[!0-9]*) fail "shard count must be a nonnegative integer" ;;
    esac
    if [ "$SHARD_COUNT" -eq 0 ] || [ "$SHARD_INDEX" -ge "$SHARD_COUNT" ]; then
        fail "shard index $SHARD_INDEX is outside shard count $SHARD_COUNT"
    fi
}

run_expectation_script() {
    script=$1
    case "$script" in
        '' | '#'*)
            return
            ;;
        /*)
            script_path=$script
            ;;
        *)
            script_path="$ROOT_DIR/$script"
            ;;
    esac

    if [ ! -f "$script_path" ]; then
        printf '%s\n' "missing expectation script: $script" >&2
        failures=$((failures + 1))
        total=$((total + 1))
        return
    fi

    total=$((total + 1))
    start_seconds=$(date +%s)
    printf '%s\n' "==> $script"
    if ! MYLITE_MYSQL_CONTAINER="$MYSQL_CONTAINER" "$MYSQL_RESET_TOOL"; then
        end_seconds=$(date +%s)
        printf '%s\n' "failed to reset MySQL for $script ($((end_seconds - start_seconds))s)" >&2
        failures=$((failures + 1))
        return
    fi
    if ! verify_mysql_runtime; then
        end_seconds=$(date +%s)
        printf '%s\n' "failed to verify MySQL for $script ($((end_seconds - start_seconds))s)" >&2
        failures=$((failures + 1))
        return
    fi
    if MYLITE_MYSQL_CONTAINER="$MYSQL_CONTAINER" sh "$script_path"; then
        end_seconds=$(date +%s)
        printf '%s\n' "ok $script ($((end_seconds - start_seconds))s)"
    else
        end_seconds=$(date +%s)
        printf '%s\n' "failed $script ($((end_seconds - start_seconds))s)" >&2
        failures=$((failures + 1))
    fi
}

run_manifest_script() {
    script=$1
    case "$script" in
        '' | '#'*)
            return
            ;;
    esac

    script_index=$manifest_script_index
    manifest_script_index=$((manifest_script_index + 1))
    if [ -n "$SHARD_COUNT" ] && [ $((script_index % SHARD_COUNT)) -ne "$SHARD_INDEX" ]; then
        return
    fi
    run_expectation_script "$script"
}

validate_shard_configuration

if [ "$#" -gt 0 ]; then
    for script in "$@"; do
        run_expectation_script "$script"
    done
else
    if [ ! -f "$MANIFEST" ]; then
        fail "missing expectation manifest: $MANIFEST"
    fi
    while IFS= read -r script || [ -n "$script" ]; do
        run_manifest_script "$script"
    done <"$MANIFEST"
fi

if [ "$failures" -ne 0 ]; then
    fail "$failures of $total expectation scripts failed"
fi

if [ -n "$SHARD_COUNT" ]; then
    printf '%s\n' \
        "run-mysql-runtime-expectations: $total scripts passed in shard $SHARD_INDEX/$SHARD_COUNT"
else
    printf '%s\n' "run-mysql-runtime-expectations: $total scripts passed"
fi
