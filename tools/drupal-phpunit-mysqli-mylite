#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image="${MYLITE_DRUPAL_DOCKER_IMAGE:-mylite-drupal-phpunit:php84}"
drupal_repo="${MYLITE_DRUPAL_REPO:-https://git.drupalcode.org/project/drupal.git}"
drupal_ref="${MYLITE_DRUPAL_REF:-11.3.11}"
drupal_dir="${MYLITE_DRUPAL_DIR:-${root_dir}/build/drupal-core}"
cmake_build_dir="${MYLITE_DRUPAL_CMAKE_BUILD_DIR:-${root_dir}/build/drupal-php-mylite}"
cmake_build_type="${MYLITE_DRUPAL_CMAKE_BUILD_TYPE:-Release}"
db_file_name="${MYLITE_DRUPAL_DB_FILE_NAME:-drupal-tests.mylite}"
db_name="${MYLITE_DRUPAL_DB_NAME:-drupal_tests}"
db_prefix="${MYLITE_DRUPAL_DB_PREFIX:-mylite_drupal_}"
container_root="/work"
container_drupal_dir="${container_root}${drupal_dir#"${root_dir}"}"
container_cmake_build_dir="${container_root}${cmake_build_dir#"${root_dir}"}"

container_path_for() {
  local path="$1"

  if [[ "${path}" != /* ]]; then
    printf '%s/%s\n' "${container_root}" "${path#./}"
    return
  fi

  if [[ "${path}" == "${root_dir}" || "${path}" == "${root_dir}/"* ]]; then
    printf '%s%s\n' "${container_root}" "${path#"${root_dir}"}"
    return
  fi

  printf '%s\n' "${path}"
}

container_mysqli_profile="${MYLITE_MYSQLI_PROFILE:-}"
if [[ -n "${container_mysqli_profile}" ]]; then
  container_mysqli_profile="$(container_path_for "${container_mysqli_profile}")"
fi

build_image() {
  docker build -t "${image}" - <<'DOCKERFILE'
FROM composer:2@sha256:5946476338742b200bb9ff88f8be56275ddae4b3949c72305cb0dbf10cfcb760 AS composer
FROM php:8.4-cli-bookworm@sha256:138a210978c7767ef2a26f499c413fe6de1c13233c9a5068139565c81191b1ac

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libfreetype6-dev \
    libicu-dev \
    libjpeg62-turbo-dev \
    libonig-dev \
    libpng-dev \
    libwebp-dev \
    libzip-dev \
    ninja-build \
    pkg-config \
    unzip \
    zlib1g-dev \
  && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
  && docker-php-ext-install -j"$(nproc)" gd intl mbstring zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
DOCKERFILE
}

usage() {
  cat <<USAGE
usage: tools/drupal-phpunit-mysqli-mylite [command] [phpunit-args...]

Commands:
  image                 Build the Docker image.
  fetch-drupal          Fetch the Drupal test checkout.
  build-extensions      Build the MyLite PHP extensions and PHP wrapper.
  install-dependencies  Install Drupal PHPUnit dependencies.
  build                 Build the Docker image and full PHPUnit environment.
  test                  Run the Drupal database PHPUnit test suite.
  run                   Build the environment, then run the Drupal database PHPUnit test suite.
USAGE
}

run_container() {
  docker run --rm -i \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp/mylite-home \
    -e MYLITE_DRUPAL_REPO="${drupal_repo}" \
    -e MYLITE_DRUPAL_REF="${drupal_ref}" \
    -e MYLITE_DRUPAL_DIR="${container_drupal_dir}" \
    -e MYLITE_DRUPAL_CMAKE_BUILD_DIR="${container_cmake_build_dir}" \
    -e MYLITE_DRUPAL_CMAKE_BUILD_TYPE="${cmake_build_type}" \
    -e MYLITE_DRUPAL_DB_FILE_NAME="${db_file_name}" \
    -e MYLITE_DRUPAL_DB_NAME="${db_name}" \
    -e MYLITE_DRUPAL_DB_PREFIX="${db_prefix}" \
    -e MYLITE_MYSQLI_PROFILE="${container_mysqli_profile}" \
    -e MYLITE_MYSQLI_PROFILE_LIMIT="${MYLITE_MYSQLI_PROFILE_LIMIT:-}" \
    -v "${root_dir}:${container_root}" \
    -w "${container_root}" \
    "${image}" \
    bash -s -- "$@" <<'CONTAINER'
set -euo pipefail

container_phase="${1:-run}"
if [ "$#" -gt 0 ]; then
  shift
fi
php_wrapper="${MYLITE_DRUPAL_CMAKE_BUILD_DIR}/mylite-drupal-php"
mylite_extension="${MYLITE_DRUPAL_CMAKE_BUILD_DIR}/packages/php-ext-mylite/mylite.so"
mysqli_extension="${MYLITE_DRUPAL_CMAKE_BUILD_DIR}/packages/php-ext-mysqli-mylite/mysqli.so"
php_ini_dir="${MYLITE_DRUPAL_CMAKE_BUILD_DIR}/php-conf.d"
drupal_core_dir="${MYLITE_DRUPAL_DIR}/core"
drupal_db_path="${drupal_core_dir}/${MYLITE_DRUPAL_DB_FILE_NAME}"
drupal_db_url="mysqli://root@${MYLITE_DRUPAL_DB_FILE_NAME}/${MYLITE_DRUPAL_DB_NAME}#${MYLITE_DRUPAL_DB_PREFIX}"

phase() {
  printf '\n==> %s\n' "$*"
}

seconds_since() {
  local start="$1"
  local end
  end="$(date +%s)"
  echo "$((end - start))"
}

require_executable() {
  if [ ! -x "$1" ]; then
    printf '%s\n' "missing executable: $1" >&2
    printf '%s\n' "run tools/drupal-phpunit-mysqli-mylite build first" >&2
    exit 1
  fi
}

fetch_drupal_core() {
  mkdir -p "${HOME}" "$(dirname "${MYLITE_DRUPAL_DIR}")"

  phase "Fetch Drupal core"
  local fetch_start
  fetch_start="$(date +%s)"
  if [ ! -d "${MYLITE_DRUPAL_DIR}/.git" ]; then
    git init "${MYLITE_DRUPAL_DIR}"
    git -C "${MYLITE_DRUPAL_DIR}" remote add origin "${MYLITE_DRUPAL_REPO}"
  fi
  git -C "${MYLITE_DRUPAL_DIR}" fetch --depth 1 origin "${MYLITE_DRUPAL_REF}"
  git -C "${MYLITE_DRUPAL_DIR}" checkout --detach FETCH_HEAD
  drupal_sha="$(git -C "${MYLITE_DRUPAL_DIR}" rev-parse HEAD)"
  echo "drupal_sha=${drupal_sha}"
  echo "drupal_fetch_seconds=$(seconds_since "${fetch_start}")"
}

build_mylite_php_extensions() {
  phase "Build MyLite PHP extensions"
  local build_start
  build_start="$(date +%s)"
  cmake -S . -B "${MYLITE_DRUPAL_CMAKE_BUILD_DIR}" -G Ninja \
    -DCMAKE_BUILD_TYPE="${MYLITE_DRUPAL_CMAKE_BUILD_TYPE}" \
    -DMYLITE_WARNINGS_AS_ERRORS=ON \
    -DMYLITE_BUILD_PHP_EXTENSIONS=ON \
    -DMYLITE_PHP_CONFIG_EXECUTABLE=/usr/local/bin/php-config \
    -DMYLITE_PHP_EXECUTABLE=/usr/local/bin/php
  cmake --build "${MYLITE_DRUPAL_CMAKE_BUILD_DIR}" --target mylite_php_mysqli_extension
  mkdir -p "${php_ini_dir}"
  cat > "${php_ini_dir}/mylite.ini" <<INI
extension=${mylite_extension}
extension=${mysqli_extension}
INI
  cat > "${php_wrapper}" <<PHP
#!/usr/bin/env sh
export PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}"
exec /usr/local/bin/php "\$@"
PHP
  chmod +x "${php_wrapper}"
  "${php_wrapper}" -r 'if (!extension_loaded("mylite") || !extension_loaded("mysqli") || !function_exists("mysqli_connect")) { exit(1); }'
  echo "mylite_build_seconds=$(seconds_since "${build_start}")"
}

install_drupal_phpunit_dependencies() {
  mkdir -p "${HOME}"
  phase "Install Drupal PHPUnit dependencies"
  local deps_start
  deps_start="$(date +%s)"
  composer --working-dir="${MYLITE_DRUPAL_DIR}" install --no-interaction --no-progress --prefer-dist
  echo "drupal_dependency_seconds=$(seconds_since "${deps_start}")"
}

write_drupal_phpunit_config() {
  cp "${drupal_core_dir}/phpunit.xml.dist" "${drupal_core_dir}/phpunit.xml"
  "${php_wrapper}" -r '
$path = $argv[1];
$db = $argv[2];
$output = $argv[3];
$xml = file_get_contents($path);
$xml = preg_replace(
    "/<env name=\"SIMPLETEST_DB\" value=\"[^\"]*\"\\/>/",
    "<env name=\"SIMPLETEST_DB\" value=\"" . htmlspecialchars($db, ENT_QUOTES) . "\"/>",
    $xml
);
$xml = preg_replace(
    "/<env name=\"BROWSERTEST_OUTPUT_BASE_URL\" value=\"[^\"]*\"\\/>/",
    "<env name=\"BROWSERTEST_OUTPUT_BASE_URL\" value=\"http://localhost\"/>",
    $xml
);
file_put_contents($path, $xml);
@mkdir($output, 0777, true);
' "${drupal_core_dir}/phpunit.xml" "${drupal_db_url}" "${drupal_core_dir}/sites/simpletest/browser_output"
}

prepare_drupal_database() {
  phase "Prepare MyLite database"
  rm -f \
    "${drupal_db_path}" \
    "${drupal_db_path}-journal" \
    "${drupal_db_path}-wal" \
    "${drupal_db_path}-shm"
  (
    cd "${drupal_core_dir}"
    "${php_wrapper}" -r '
$host = $argv[1];
$database = $argv[2];
$db = mysqli_connect($host);
if (!$db) {
    fwrite(STDERR, "connect failed: " . (mysqli_connect_error() ?? "") . PHP_EOL);
    exit(1);
}
if (!mysqli_query($db, "CREATE DATABASE IF NOT EXISTS `" . str_replace("`", "``", $database) . "`")) {
    fwrite(STDERR, "create database failed: " . mysqli_error($db) . PHP_EOL);
    exit(1);
}
mysqli_close($db);
' "${MYLITE_DRUPAL_DB_FILE_NAME}" "${MYLITE_DRUPAL_DB_NAME}"
  )
}

build_drupal_phpunit_environment() {
  fetch_drupal_core
  build_mylite_php_extensions
  install_drupal_phpunit_dependencies
}

phpunit_output_has_nonpassing_summary() {
  grep -Eq '^(FAILURES!|ERRORS!|No tests executed!|There (was|were) [0-9]+ (failure|failures|error|errors))' "$1"
}

reset_mysqli_profile() {
  if [ -z "${MYLITE_MYSQLI_PROFILE:-}" ] ||
    [ "${MYLITE_MYSQLI_PROFILE}" = "1" ] ||
    [ "${MYLITE_MYSQLI_PROFILE}" = "stderr" ]; then
    return
  fi
  mkdir -p "$(dirname "${MYLITE_MYSQLI_PROFILE}")"
  rm -f "${MYLITE_MYSQLI_PROFILE}"
}

print_mysqli_profile() {
  if [ -z "${MYLITE_MYSQLI_PROFILE:-}" ] ||
    [ "${MYLITE_MYSQLI_PROFILE}" = "1" ] ||
    [ "${MYLITE_MYSQLI_PROFILE}" = "stderr" ] ||
    [ ! -s "${MYLITE_MYSQLI_PROFILE}" ]; then
    return
  fi

  phase "MyLite mysqli profile"
  cat "${MYLITE_MYSQLI_PROFILE}"
}

run_drupal_phpunit_suite() {
  require_executable "${php_wrapper}"
  require_executable "${MYLITE_DRUPAL_DIR}/vendor/bin/phpunit"
  mkdir -p "${MYLITE_DRUPAL_CMAKE_BUILD_DIR}"

  prepare_drupal_database
  write_drupal_phpunit_config
  reset_mysqli_profile

  phase "Run Drupal PHPUnit test suite"
  suite_log="${MYLITE_DRUPAL_CMAKE_BUILD_DIR}/drupal-phpunit.log"
  suite_start="$(date +%s)"
  set +e
  (
    cd "${drupal_core_dir}"
    if [ "$#" -eq 0 ]; then
      "${php_wrapper}" ../vendor/bin/phpunit -c phpunit.xml \
        tests/Drupal/KernelTests/Core/Database \
        tests/Drupal/Tests/Core/Database \
        modules/mysqli/tests/src/Kernel/mysqli \
        modules/mysqli/tests/src/Unit/NamedPlaceholderConverterTest.php
    else
      "${php_wrapper}" ../vendor/bin/phpunit -c phpunit.xml "$@"
    fi
  ) 2>&1 | tee "${suite_log}"
  suite_status="${PIPESTATUS[0]}"
  set -e
  if [ "${suite_status}" -eq 0 ] && phpunit_output_has_nonpassing_summary "${suite_log}"; then
    printf '%s\n' "PHPUnit reported a non-passing summary but exited with status 0" >&2
    suite_status=1
  fi
  echo "drupal_phpunit_seconds=$(seconds_since "${suite_start}")"
  print_mysqli_profile
  return "${suite_status}"
}

case "${container_phase}" in
  fetch-drupal)
    fetch_drupal_core
    ;;
  build-extensions)
    build_mylite_php_extensions
    ;;
  install-dependencies)
    install_drupal_phpunit_dependencies
    ;;
  build)
    build_drupal_phpunit_environment
    ;;
  test)
    run_drupal_phpunit_suite "$@"
    ;;
  *)
    printf 'unknown Drupal PHPUnit phase: %s\n' "${container_phase}" >&2
    exit 2
    ;;
esac
CONTAINER
}

command="run"
if [ "$#" -gt 0 ]; then
  case "$1" in
    image|fetch-drupal|build-extensions|install-dependencies|build|test|run)
      command="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'unknown command: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
fi

overall_start="$(date +%s)"
overall_status=0
set +e
case "${command}" in
  image)
    build_image
    ;;
  fetch-drupal|build-extensions|install-dependencies)
    run_container "${command}"
    ;;
  build)
    build_image
    run_container build
    ;;
  test)
    run_container test "$@"
    ;;
  run)
    build_image
    run_container build && run_container test "$@"
    ;;
  *)
    printf 'unknown command: %s\n' "${command}" >&2
    false
    ;;
esac
overall_status="$?"
set -e
overall_end="$(date +%s)"
echo "drupal_total_seconds=$((overall_end - overall_start))"
exit "${overall_status}"
